<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="studio_care_definitions" targetNamespace="https://example.org/workflow-studio" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="studio_care" name="Patient access and appointment coordination" isExecutable="true">
    <bpmn:startEvent id="h_start" name="Request received">
      <bpmn:outgoing>studio_care_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="h_check" name="Validate registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="studio.care.check" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_care_f0</bpmn:incoming>
      <bpmn:outgoing>studio_care_f1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="h_valid" name="Registered?" default="studio_care_f3">
      <bpmn:incoming>studio_care_f1</bpmn:incoming>
      <bpmn:outgoing>studio_care_f2</bpmn:outgoing>
      <bpmn:outgoing>studio_care_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="h_invalid" name="Registration required">
      <bpmn:incoming>studio_care_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="h_policy" name="Classify access priority">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="studio_access_policy" resultVariable="route" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_care_f2</bpmn:incoming>
      <bpmn:outgoing>studio_care_f4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="h_route" name="Access route?" default="studio_care_f7">
      <bpmn:incoming>studio_care_f4</bpmn:incoming>
      <bpmn:outgoing>studio_care_f5</bpmn:outgoing>
      <bpmn:outgoing>studio_care_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="h_urgent" name="Acknowledge urgent handoff">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="studio_urgent_handoff" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_care_f5</bpmn:incoming>
      <bpmn:outgoing>studio_care_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="h_escalated" name="Urgent handoff recorded">
      <bpmn:incoming>studio_care_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="h_slots" name="Find demonstration slot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=mockApiBaseUrl + &quot;/api/slots&quot;" target="url" />
          <zeebe:input source="=schedulingRequest" target="body" />
          <zeebe:input source="=5" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=5" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={slotAvailable: response.body.slotAvailable, assignedSlot: response.body.assignedSlot, availableSlots: response.body.availableSlots}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>studio_care_f7</bpmn:incoming>
      <bpmn:outgoing>studio_care_f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="h_slot" name="Routine with slot?" default="studio_care_f10">
      <bpmn:incoming>studio_care_f8</bpmn:incoming>
      <bpmn:outgoing>studio_care_f9</bpmn:outgoing>
      <bpmn:outgoing>studio_care_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="h_review" name="Resolve appointment request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="studio_care_review" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_care_f10</bpmn:incoming>
      <bpmn:outgoing>studio_care_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="h_resolution" name="Staff resolution?" default="studio_care_f14">
      <bpmn:incoming>studio_care_f11</bpmn:incoming>
      <bpmn:outgoing>studio_care_f12</bpmn:outgoing>
      <bpmn:outgoing>studio_care_f13</bpmn:outgoing>
      <bpmn:outgoing>studio_care_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="h_book" name="Confirm demonstration booking">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="studio.care.book" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_care_f9</bpmn:incoming>
      <bpmn:incoming>studio_care_f12</bpmn:incoming>
      <bpmn:outgoing>studio_care_f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="h_done" name="Appointment confirmed">
      <bpmn:incoming>studio_care_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="h_wait" name="Added to waitlist">
      <bpmn:incoming>studio_care_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="h_decline" name="Request declined">
      <bpmn:incoming>studio_care_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="studio_care_f0" sourceRef="h_start" targetRef="h_check" name="" />
    <bpmn:sequenceFlow id="studio_care_f1" sourceRef="h_check" targetRef="h_valid" name="" />
    <bpmn:sequenceFlow id="studio_care_f2" sourceRef="h_valid" targetRef="h_policy" name="Registered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=registrationValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="studio_care_f3" sourceRef="h_valid" targetRef="h_invalid" name="Invalid" />
    <bpmn:sequenceFlow id="studio_care_f4" sourceRef="h_policy" targetRef="h_route" name="" />
    <bpmn:sequenceFlow id="studio_care_f5" sourceRef="h_route" targetRef="h_urgent" name="Urgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=route = "Urgent Assessment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="studio_care_f6" sourceRef="h_urgent" targetRef="h_escalated" name="" />
    <bpmn:sequenceFlow id="studio_care_f7" sourceRef="h_route" targetRef="h_slots" name="Schedule" />
    <bpmn:sequenceFlow id="studio_care_f8" sourceRef="h_slots" targetRef="h_slot" name="" />
    <bpmn:sequenceFlow id="studio_care_f9" sourceRef="h_slot" targetRef="h_book" name="Book">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=route = "Routine" and slotAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="studio_care_f10" sourceRef="h_slot" targetRef="h_review" name="Staff review" />
    <bpmn:sequenceFlow id="studio_care_f11" sourceRef="h_review" targetRef="h_resolution" name="" />
    <bpmn:sequenceFlow id="studio_care_f12" sourceRef="h_resolution" targetRef="h_book" name="Book">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=staffResolution = "BOOK" and assignedSlot != ""</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="studio_care_f13" sourceRef="h_resolution" targetRef="h_wait" name="Waitlist">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=staffResolution = "WAITLIST"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="studio_care_f14" sourceRef="h_resolution" targetRef="h_decline" name="Decline" />
    <bpmn:sequenceFlow id="studio_care_f15" sourceRef="h_book" targetRef="h_done" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="studio_care_diagram">
    <bpmndi:BPMNPlane id="studio_care_plane" bpmnElement="studio_care">
      <bpmndi:BPMNShape id="h_start_di" bpmnElement="h_start">
        <dc:Bounds x="60" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="20" y="166" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_check_di" bpmnElement="h_check">
        <dc:Bounds x="150" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_valid_di" bpmnElement="h_valid">
        <dc:Bounds x="350" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="310" y="173" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_invalid_di" bpmnElement="h_invalid">
        <dc:Bounds x="490" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="450" y="526" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_policy_di" bpmnElement="h_policy">
        <dc:Bounds x="460" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_route_di" bpmnElement="h_route">
        <dc:Bounds x="660" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620" y="173" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_urgent_di" bpmnElement="h_urgent">
        <dc:Bounds x="780" y="300" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_escalated_di" bpmnElement="h_escalated">
        <dc:Bounds x="990" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="950" y="366" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_slots_di" bpmnElement="h_slots">
        <dc:Bounds x="780" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_slot_di" bpmnElement="h_slot">
        <dc:Bounds x="980" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="173" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_review_di" bpmnElement="h_review">
        <dc:Bounds x="1110" y="300" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_resolution_di" bpmnElement="h_resolution">
        <dc:Bounds x="1310" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1270" y="373" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_book_di" bpmnElement="h_book">
        <dc:Bounds x="1430" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_done_di" bpmnElement="h_done">
        <dc:Bounds x="1640" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1600" y="166" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_wait_di" bpmnElement="h_wait">
        <dc:Bounds x="1450" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1410" y="526" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_decline_di" bpmnElement="h_decline">
        <dc:Bounds x="1640" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1600" y="526" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="studio_care_f0_di" bpmnElement="studio_care_f0">
        <di:waypoint x="96" y="140.0" />
        <di:waypoint x="150" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f1_di" bpmnElement="studio_care_f1">
        <di:waypoint x="300" y="140.0" />
        <di:waypoint x="350" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f2_di" bpmnElement="studio_care_f2">
        <di:waypoint x="400" y="140.0" />
        <di:waypoint x="460" y="140.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f3_di" bpmnElement="studio_care_f3">
        <di:waypoint x="400" y="140.0" />
        <di:waypoint x="445.0" y="140.0" />
        <di:waypoint x="445.0" y="500.0" />
        <di:waypoint x="490" y="500.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f4_di" bpmnElement="studio_care_f4">
        <di:waypoint x="610" y="140.0" />
        <di:waypoint x="660" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f5_di" bpmnElement="studio_care_f5">
        <di:waypoint x="710" y="140.0" />
        <di:waypoint x="745.0" y="140.0" />
        <di:waypoint x="745.0" y="340.0" />
        <di:waypoint x="780" y="340.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="715" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f6_di" bpmnElement="studio_care_f6">
        <di:waypoint x="930" y="340.0" />
        <di:waypoint x="990" y="340.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f7_di" bpmnElement="studio_care_f7">
        <di:waypoint x="710" y="140.0" />
        <di:waypoint x="780" y="140.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="715" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f8_di" bpmnElement="studio_care_f8">
        <di:waypoint x="930" y="140.0" />
        <di:waypoint x="980" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f9_di" bpmnElement="studio_care_f9">
        <di:waypoint x="1030" y="140.0" />
        <di:waypoint x="1430" y="140.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f10_di" bpmnElement="studio_care_f10">
        <di:waypoint x="1030" y="140.0" />
        <di:waypoint x="1070.0" y="140.0" />
        <di:waypoint x="1070.0" y="340.0" />
        <di:waypoint x="1110" y="340.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f11_di" bpmnElement="studio_care_f11">
        <di:waypoint x="1260" y="340.0" />
        <di:waypoint x="1310" y="340.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f12_di" bpmnElement="studio_care_f12">
