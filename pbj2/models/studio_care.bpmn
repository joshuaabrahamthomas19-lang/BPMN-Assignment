        <di:waypoint x="1430" y="140.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1365" y="315.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_care_f13_di" bpmnElement="studio_care_f13">
