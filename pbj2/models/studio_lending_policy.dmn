<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="https://www.omg.org/spec/DMN/20191111/MODEL/" id="studio_lending_policy_definitions" name="Affordability-first lending" namespace="https://example.org/workflow-studio">
  <ns0:decision id="studio_lending_policy" name="Affordability-first lending">
    <ns0:decisionTable id="studio_lending_policy_table" hitPolicy="FIRST">
      <ns0:input id="studio_lending_policy_input0" label="creditScore">
        <ns0:inputExpression id="studio_lending_policy_expr0" typeRef="number">
          <ns0:text>creditScore</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:input id="studio_lending_policy_input1" label="paymentRatio">
        <ns0:inputExpression id="studio_lending_policy_expr1" typeRef="number">
          <ns0:text>paymentRatio</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:input id="studio_lending_policy_input2" label="requestedAmount">
        <ns0:inputExpression id="studio_lending_policy_expr2" typeRef="number">
          <ns0:text>requestedAmount</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:output id="studio_lending_policy_output" name="route" label="Route" typeRef="string" />
      <ns0:rule id="studio_lending_policy_rule0">
        <ns0:inputEntry id="studio_lending_policy_test0_0">
          <ns0:text>&lt; 580</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_lending_policy_test0_1">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_lending_policy_test0_2">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="studio_lending_policy_result0">
          <ns0:text>"Rejected"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="studio_lending_policy_rule1">
        <ns0:inputEntry id="studio_lending_policy_test1_0">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_lending_policy_test1_1">
          <ns0:text>&gt; 0.45</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_lending_policy_test1_2">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="studio_lending_policy_result1">
          <ns0:text>"Rejected"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="studio_lending_policy_rule2">
        <ns0:inputEntry id="studio_lending_policy_test2_0">
          <ns0:text>&gt;= 720</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_lending_policy_test2_1">
          <ns0:text>&lt;= 0.30</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_lending_policy_test2_2">
          <ns0:text>&lt;= 40000</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="studio_lending_policy_result2">
          <ns0:text>"Approved"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="studio_lending_policy_rule3">
        <ns0:inputEntry id="studio_lending_policy_test3_0">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_lending_policy_test3_1">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_lending_policy_test3_2">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="studio_lending_policy_result3">
          <ns0:text>"Manual Review"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
    </ns0:decisionTable>
  </ns0:decision>
</ns0:definitions>