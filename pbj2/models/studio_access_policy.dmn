<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="https://www.omg.org/spec/DMN/20191111/MODEL/" id="studio_access_policy_definitions" name="Synthetic patient access policy" namespace="https://example.org/workflow-studio">
  <ns0:decision id="studio_access_policy" name="Synthetic patient access policy">
    <ns0:decisionTable id="studio_access_policy_table" hitPolicy="FIRST">
      <ns0:input id="studio_access_policy_input0" label="urgency">
        <ns0:inputExpression id="studio_access_policy_expr0" typeRef="string">
          <ns0:text>urgency</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:input id="studio_access_policy_input1" label="patientAge">
        <ns0:inputExpression id="studio_access_policy_expr1" typeRef="number">
          <ns0:text>patientAge</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:output id="studio_access_policy_output" name="route" label="Route" typeRef="string" />
      <ns0:rule id="studio_access_policy_rule0">
        <ns0:inputEntry id="studio_access_policy_test0_0">
          <ns0:text>"CRITICAL"</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_access_policy_test0_1">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="studio_access_policy_result0">
          <ns0:text>"Urgent Assessment"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="studio_access_policy_rule1">
        <ns0:inputEntry id="studio_access_policy_test1_0">
          <ns0:text>"MODERATE"</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_access_policy_test1_1">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="studio_access_policy_result1">
          <ns0:text>"Priority Review"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="studio_access_policy_rule2">
        <ns0:inputEntry id="studio_access_policy_test2_0">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_access_policy_test2_1">
          <ns0:text>&lt; 6</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="studio_access_policy_result2">
          <ns0:text>"Priority Review"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="studio_access_policy_rule3">
        <ns0:inputEntry id="studio_access_policy_test3_0">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_access_policy_test3_1">
          <ns0:text>&gt;= 70</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="studio_access_policy_result3">
          <ns0:text>"Priority Review"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="studio_access_policy_rule4">
        <ns0:inputEntry id="studio_access_policy_test4_0">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="studio_access_policy_test4_1">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="studio_access_policy_result4">
          <ns0:text>"Routine"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
    </ns0:decisionTable>
  </ns0:decision>
</ns0:definitions>