<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="studio_order_definitions" targetNamespace="https://example.org/workflow-studio" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="studio_order" name="Reserve, verify and release fulfilment" isExecutable="true">
    <bpmn:startEvent id="o_start" name="Order received">
      <bpmn:outgoing>studio_order_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="o_reserve" name="Validate and reserve stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="studio.order.reserve" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_order_f0</bpmn:incoming>
      <bpmn:outgoing>studio_order_f1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="o_stock" name="Stock reserved?" default="studio_order_f3">
      <bpmn:incoming>studio_order_f1</bpmn:incoming>
      <bpmn:outgoing>studio_order_f2</bpmn:outgoing>
      <bpmn:outgoing>studio_order_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="o_empty" name="Stock unavailable">
      <bpmn:incoming>studio_order_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="o_policy" name="Determine dispatch lane">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="studio_dispatch_policy" resultVariable="route" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_order_f2</bpmn:incoming>
      <bpmn:outgoing>studio_order_f4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="o_gate" name="Audit required?" default="studio_order_f6">
      <bpmn:incoming>studio_order_f4</bpmn:incoming>
      <bpmn:outgoing>studio_order_f5</bpmn:outgoing>
      <bpmn:outgoing>studio_order_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="o_review" name="Approve purchase">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="studio_order_review" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_order_f5</bpmn:incoming>
      <bpmn:outgoing>studio_order_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_approved" name="Purchase approved?" default="studio_order_f9">
      <bpmn:incoming>studio_order_f7</bpmn:incoming>
      <bpmn:outgoing>studio_order_f8</bpmn:outgoing>
      <bpmn:outgoing>studio_order_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="o_payment" name="Simulate payment authorization">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=mockApiBaseUrl + &quot;/api/payment&quot;" target="url" />
          <zeebe:input source="={orderId: orderId, orderTotal: orderTotal, paymentToken: paymentToken}" target="body" />
          <zeebe:input source="=5" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=5" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={paymentAccepted: response.body.paymentAccepted, transactionRef: response.body.transactionRef}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>studio_order_f6</bpmn:incoming>
      <bpmn:incoming>studio_order_f8</bpmn:incoming>
      <bpmn:outgoing>studio_order_f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="o_paid" name="Payment accepted?" default="studio_order_f12">
      <bpmn:incoming>studio_order_f10</bpmn:incoming>
      <bpmn:outgoing>studio_order_f11</bpmn:outgoing>
      <bpmn:outgoing>studio_order_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="o_ship" name="Dispatch reserved stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="studio.order.ship" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_order_f11</bpmn:incoming>
      <bpmn:outgoing>studio_order_f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="o_done" name="Dispatched">
      <bpmn:incoming>studio_order_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="o_release" name="Release stock reservation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="studio.order.release" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>studio_order_f9</bpmn:incoming>
      <bpmn:incoming>studio_order_f12</bpmn:incoming>
      <bpmn:outgoing>studio_order_f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="o_cancel" name="Order cancelled">
      <bpmn:incoming>studio_order_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="studio_order_f0" sourceRef="o_start" targetRef="o_reserve" name="" />
    <bpmn:sequenceFlow id="studio_order_f1" sourceRef="o_reserve" targetRef="o_stock" name="" />
    <bpmn:sequenceFlow id="studio_order_f2" sourceRef="o_stock" targetRef="o_policy" name="In stock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockReserved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="studio_order_f3" sourceRef="o_stock" targetRef="o_empty" name="Unavailable" />
    <bpmn:sequenceFlow id="studio_order_f4" sourceRef="o_policy" targetRef="o_gate" name="" />
    <bpmn:sequenceFlow id="studio_order_f5" sourceRef="o_gate" targetRef="o_review" name="Audit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=route = "AUDIT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="studio_order_f6" sourceRef="o_gate" targetRef="o_payment" name="Direct" />
    <bpmn:sequenceFlow id="studio_order_f7" sourceRef="o_review" targetRef="o_approved" name="" />
    <bpmn:sequenceFlow id="studio_order_f8" sourceRef="o_approved" targetRef="o_payment" name="Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=purchaseApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="studio_order_f9" sourceRef="o_approved" targetRef="o_release" name="Declined" />
    <bpmn:sequenceFlow id="studio_order_f10" sourceRef="o_payment" targetRef="o_paid" name="" />
    <bpmn:sequenceFlow id="studio_order_f11" sourceRef="o_paid" targetRef="o_ship" name="Accepted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="studio_order_f12" sourceRef="o_paid" targetRef="o_release" name="Failed" />
    <bpmn:sequenceFlow id="studio_order_f13" sourceRef="o_ship" targetRef="o_done" name="" />
    <bpmn:sequenceFlow id="studio_order_f14" sourceRef="o_release" targetRef="o_cancel" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="studio_order_diagram">
    <bpmndi:BPMNPlane id="studio_order_plane" bpmnElement="studio_order">
      <bpmndi:BPMNShape id="o_start_di" bpmnElement="o_start">
        <dc:Bounds x="60" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="20" y="166" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_reserve_di" bpmnElement="o_reserve">
        <dc:Bounds x="150" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_stock_di" bpmnElement="o_stock">
        <dc:Bounds x="350" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="310" y="173" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_empty_di" bpmnElement="o_empty">
        <dc:Bounds x="490" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="450" y="506" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_policy_di" bpmnElement="o_policy">
        <dc:Bounds x="460" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_gate_di" bpmnElement="o_gate">
        <dc:Bounds x="660" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620" y="173" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_review_di" bpmnElement="o_review">
        <dc:Bounds x="780" y="280" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_approved_di" bpmnElement="o_approved">
        <dc:Bounds x="980" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="353" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_payment_di" bpmnElement="o_payment">
        <dc:Bounds x="1110" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_paid_di" bpmnElement="o_paid">
        <dc:Bounds x="1310" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1270" y="173" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_ship_di" bpmnElement="o_ship">
        <dc:Bounds x="1430" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_done_di" bpmnElement="o_done">
        <dc:Bounds x="1640" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1600" y="166" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_release_di" bpmnElement="o_release">
        <dc:Bounds x="1430" y="420" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_cancel_di" bpmnElement="o_cancel">
        <dc:Bounds x="1640" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1600" y="486" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="studio_order_f0_di" bpmnElement="studio_order_f0">
        <di:waypoint x="96" y="140.0" />
        <di:waypoint x="150" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f1_di" bpmnElement="studio_order_f1">
        <di:waypoint x="300" y="140.0" />
        <di:waypoint x="350" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f2_di" bpmnElement="studio_order_f2">
        <di:waypoint x="400" y="140.0" />
        <di:waypoint x="460" y="140.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f3_di" bpmnElement="studio_order_f3">
        <di:waypoint x="400" y="140.0" />
        <di:waypoint x="445.0" y="140.0" />
        <di:waypoint x="445.0" y="480.0" />
        <di:waypoint x="490" y="480.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f4_di" bpmnElement="studio_order_f4">
        <di:waypoint x="610" y="140.0" />
        <di:waypoint x="660" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f5_di" bpmnElement="studio_order_f5">
        <di:waypoint x="710" y="140.0" />
        <di:waypoint x="745.0" y="140.0" />
        <di:waypoint x="745.0" y="320.0" />
        <di:waypoint x="780" y="320.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="715" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f6_di" bpmnElement="studio_order_f6">
        <di:waypoint x="710" y="140.0" />
        <di:waypoint x="1110" y="140.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="715" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f7_di" bpmnElement="studio_order_f7">
        <di:waypoint x="930" y="320.0" />
        <di:waypoint x="980" y="320.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f8_di" bpmnElement="studio_order_f8">
        <di:waypoint x="1030" y="320.0" />
        <di:waypoint x="1070.0" y="320.0" />
        <di:waypoint x="1070.0" y="140.0" />
        <di:waypoint x="1110" y="140.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="295.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f9_di" bpmnElement="studio_order_f9">
        <di:waypoint x="1030" y="320.0" />
        <di:waypoint x="1230.0" y="320.0" />
        <di:waypoint x="1230.0" y="460.0" />
        <di:waypoint x="1430" y="460.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="295.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f10_di" bpmnElement="studio_order_f10">
        <di:waypoint x="1260" y="140.0" />
        <di:waypoint x="1310" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f11_di" bpmnElement="studio_order_f11">
        <di:waypoint x="1360" y="140.0" />
        <di:waypoint x="1430" y="140.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1365" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f12_di" bpmnElement="studio_order_f12">
        <di:waypoint x="1360" y="140.0" />
        <di:waypoint x="1395.0" y="140.0" />
        <di:waypoint x="1395.0" y="460.0" />
        <di:waypoint x="1430" y="460.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1365" y="115.0" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f13_di" bpmnElement="studio_order_f13">
        <di:waypoint x="1580" y="140.0" />
        <di:waypoint x="1640" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="studio_order_f14_di" bpmnElement="studio_order_f14">
        <di:waypoint x="1580" y="460.0" />
        <di:waypoint x="1640" y="460.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>