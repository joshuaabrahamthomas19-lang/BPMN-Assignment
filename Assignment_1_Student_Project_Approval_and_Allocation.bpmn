<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_student_project" targetNamespace="https://example.org/assignments">
  <bpmn:process id="student_project" name="Assignment 1 - Student Project Approval and Allocation" isExecutable="false">
    <bpmn:laneSet id="student_project_lanes">
      <bpmn:lane id="student_project_lane_0" name="Student / Team">
        <bpmn:flowNodeRef>S_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_proposal_catch_S_lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_proposal_catch_S_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="student_project_lane_1" name="Project Coordinator">
        <bpmn:flowNodeRef>S_invalid_handler</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="student_project_lane_2" name="Project Management System">
        <bpmn:flowNodeRef>S_init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_withdraw_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_post_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_post_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_start" name="Team decides to submit">
      <bpmn:outgoing>Flow_S_start_S_init</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="S_init" name="Open Project Record">
      <bpmn:incoming>Flow_S_start_S_init</bpmn:incoming>
      <bpmn:outgoing>Flow_S_init_S_submit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="S_lapsed" name="Proposal lapsed">
      <bpmn:incoming>Flow_S_post_gate_S_lapsed</bpmn:incoming>
      <bpmn:incoming>Flow_S_proposal_catch_S_lapsed_S_lapsed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="S_rejected" name="Proposal rejected">
      <bpmn:incoming>Flow_S_proposal_catch_S_rejected_S_rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_start_S_init" sourceRef="S_start" targetRef="S_init" />
    <bpmn:sequenceFlow id="Flow_S_init_S_submit" sourceRef="S_init" targetRef="S_proposal" />
    <bpmn:subProcess id="S_invalid_handler" name="Invalid team closure" triggeredByEvent="true">
      <bpmn:laneSet id="S_invalid_handler_lanes">
        <bpmn:lane id="S_invalid_handler_lane_0" name="Project Coordinator">
          <bpmn:flowNodeRef>S_invalid_start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_invalid_end</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="S_invalid_handler_lane_1" name="Project Management System">
          <bpmn:flowNodeRef>S_invalid_notify</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="S_invalid_start" name="Catch invalid team">
        <bpmn:outgoing>Flow_S_invalid_start_S_invalid_notify</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="student_project_err_INVALID_TEAM" />
      </bpmn:startEvent>
      <bpmn:sendTask id="S_invalid_notify" name="Notify invalid team and reform advice">
        <bpmn:incoming>Flow_S_invalid_start_S_invalid_notify</bpmn:incoming>
        <bpmn:outgoing>Flow_S_invalid_notify_S_invalid_end</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="S_invalid_end" name="Invalid team">
        <bpmn:incoming>Flow_S_invalid_notify_S_invalid_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S_invalid_start_S_invalid_notify" sourceRef="S_invalid_start" targetRef="S_invalid_notify" />
      <bpmn:sequenceFlow id="Flow_S_invalid_notify_S_invalid_end" sourceRef="S_invalid_notify" targetRef="S_invalid_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="S_post_approval" name="Allocate Guide and Notify Student">
      <bpmn:incoming>Flow_S_post_gate_S_post_approval</bpmn:incoming>
      <bpmn:incoming>Flow_S_proposal_S_post_approval</bpmn:incoming>
      <bpmn:outgoing>Flow_S_post_approval_S_post_gate</bpmn:outgoing>
      <bpmn:laneSet id="S_post_approval_lanes">
        <bpmn:lane id="S_post_approval_lane_0" name="Project Management System">
          <bpmn:flowNodeRef>S_guide_rule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_guide_available</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_wait</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_wait_limit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_wait_count</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_reserve</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_reserve_comp</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_release</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_release_decline</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_attempt_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_finalize</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_notify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_finalize_error</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_finalize_retry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_finalize_retry_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_finalize_backoff</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_notify_error</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_notify_retry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_notify_retry_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_notify_backoff</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_reserve_error</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_reserve_retry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_reserve_retry_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_reserve_backoff</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_allocated</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_post_start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_post_lapsed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_set_lapsed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_withdraw_handler</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="S_post_approval_lane_1" name="Project Coordinator">
          <bpmn:flowNodeRef>S_manual</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_manual_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_finalize_manual</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_finalize_manual_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_notify_manual</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_notify_manual_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_reserve_manual</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_reserve_manual_gate</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="S_post_approval_lane_2" name="Faculty Guide">
          <bpmn:flowNodeRef>S_allocation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_decline_catch</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:businessRuleTask id="S_guide_rule" name="Select matching guide below workload limit">
        <bpmn:incoming>Flow_S_post_start_S_guide_rule</bpmn:incoming>
        <bpmn:incoming>Flow_S_attempt_gate_S_guide_rule</bpmn:incoming>
        <bpmn:incoming>Flow_S_wait_S_guide_rule</bpmn:incoming>
        <bpmn:outgoing>Flow_S_guide_rule_S_guide_available</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="S_guide_available" name="Matching guide available?" default="Flow_S_guide_available_S_manual">
        <bpmn:incoming>Flow_S_guide_rule_S_guide_available</bpmn:incoming>
        <bpmn:outgoing>Flow_S_guide_available_S_reserve</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_guide_available_S_manual</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="S_manual" name="Allocate manual co-guide external guide or wait">
        <bpmn:incoming>Flow_S_attempt_gate_S_manual</bpmn:incoming>
        <bpmn:incoming>Flow_S_guide_available_S_manual</bpmn:incoming>
        <bpmn:outgoing>Flow_S_manual_S_manual_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="S_manual_gate" name="Manual allocation result" default="Flow_S_manual_gate_S_lapsed">
        <bpmn:incoming>Flow_S_manual_S_manual_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_manual_gate_S_reserve</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_manual_gate_S_wait_limit</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_manual_gate_S_lapsed</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="S_wait" name="Wait before rechecking guides">
        <bpmn:incoming>Flow_S_wait_count_S_wait</bpmn:incoming>
        <bpmn:outgoing>Flow_S_wait_S_guide_rule</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P1D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="S_wait_limit" name="Waiting rounds below seven?" default="Flow_S_wait_limit_S_lapsed">
        <bpmn:incoming>Flow_S_manual_gate_S_wait_limit</bpmn:incoming>
        <bpmn:outgoing>Flow_S_wait_limit_S_wait_count</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_wait_limit_S_lapsed</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="S_wait_count" name="Count waiting round">
        <bpmn:incoming>Flow_S_wait_limit_S_wait_count</bpmn:incoming>
        <bpmn:outgoing>Flow_S_wait_count_S_wait</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S_reserve" name="Reserve and record guide slot">
        <bpmn:incoming>Flow_S_reserve_backoff_S_reserve</bpmn:incoming>
        <bpmn:incoming>Flow_S_reserve_manual_gate_S_reserve</bpmn:incoming>
        <bpmn:incoming>Flow_S_guide_available_S_reserve</bpmn:incoming>
        <bpmn:incoming>Flow_S_manual_gate_S_reserve</bpmn:incoming>
        <bpmn:outgoing>Flow_S_reserve_S_allocation</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="S_reserve_comp" name="Compensation" attachedToRef="S_reserve" cancelActivity="false">
        <bpmn:compensateEventDefinition />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="S_release" name="Release guide slot idempotently" isForCompensation="true">
        </bpmn:serviceTask>
      <bpmn:subProcess id="S_allocation" name="Guide request and confirmation">
        <bpmn:incoming>Flow_S_reserve_S_allocation</bpmn:incoming>
        <bpmn:outgoing>Flow_S_allocation_S_finalize</bpmn:outgoing>
        <bpmn:laneSet id="S_allocation_lanes">
          <bpmn:lane id="S_allocation_lane_0" name="Faculty Guide">
            <bpmn:flowNodeRef>S_alloc_start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_accept</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_accept_gate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_declined_error</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_alloc_end</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_silent</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="S_allocation_lane_1" name="Project Management System">
            <bpmn:flowNodeRef>S_request</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_request_error</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_request_retry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_request_retry_gate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_request_backoff</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="S_allocation_lane_2" name="Project Coordinator">
            <bpmn:flowNodeRef>S_request_manual</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_request_manual_gate</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="S_allocation_team_lane" name="Student / Team">
            <bpmn:flowNodeRef>S_agree_expectations</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_terms_gate</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="S_alloc_start" name="Allocation request begins">
          <bpmn:outgoing>Flow_S_alloc_start_S_request</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sendTask id="S_request" name="Send guide allocation request">
          <bpmn:incoming>Flow_S_alloc_start_S_request</bpmn:incoming>
          <bpmn:incoming>Flow_S_request_backoff_S_request</bpmn:incoming>
          <bpmn:outgoing>Flow_S_request_S_accept</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:userTask id="S_accept" name="Guide accepts or declines">
          <bpmn:incoming>Flow_S_request_S_accept</bpmn:incoming>
          <bpmn:incoming>Flow_S_request_manual_gate_S_accept</bpmn:incoming>
          <bpmn:outgoing>Flow_S_accept_S_accept_gate</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="S_accept_gate" name="Guide outcome" default="Flow_S_accept_gate_S_declined_error">
          <bpmn:incoming>Flow_S_accept_S_accept_gate</bpmn:incoming>
          <bpmn:outgoing>Flow_S_accept_gate_S_alloc_end</bpmn:outgoing>
          <bpmn:outgoing>Flow_S_accept_gate_S_declined_error</bpmn:outgoing>
          <bpmn:outgoing>Flow_S_accept_gate_S_agree_expectations</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="S_declined_error" name="Guide declined">
          <bpmn:incoming>Flow_S_accept_gate_S_declined_error</bpmn:incoming>
          <bpmn:incoming>Flow_S_silent_S_declined_error</bpmn:incoming>
          <bpmn:incoming>Flow_S_terms_gate_S_declined_error</bpmn:incoming>
          <bpmn:errorEventDefinition errorRef="student_project_err_GUIDE_DECLINED" />
        </bpmn:endEvent>
        <bpmn:endEvent id="S_alloc_end" name="Guide confirmed">
          <bpmn:incoming>Flow_S_accept_gate_S_alloc_end</bpmn:incoming>
          <bpmn:incoming>Flow_S_terms_gate_S_alloc_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_S_alloc_start_S_request" sourceRef="S_alloc_start" targetRef="S_request" />
        <bpmn:sequenceFlow id="Flow_S_request_S_accept" sourceRef="S_request" targetRef="S_accept" />
        <bpmn:sequenceFlow id="Flow_S_accept_S_accept_gate" sourceRef="S_accept" targetRef="S_accept_gate" />
        <bpmn:sequenceFlow id="Flow_S_accept_gate_S_alloc_end" sourceRef="S_accept_gate" targetRef="S_alloc_end" name="Accept">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= guideDecision = "accept"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_S_accept_gate_S_declined_error" sourceRef="S_accept_gate" targetRef="S_declined_error" name="Decline" />
        <bpmn:boundaryEvent id="S_silent" name="Guide silent for three days" attachedToRef="S_accept" cancelActivity="true">
          <bpmn:outgoing>Flow_S_silent_S_declined_error</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>P3D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Flow_S_silent_S_declined_error" sourceRef="S_silent" targetRef="S_declined_error" />
        <bpmn:boundaryEvent id="S_request_error" name="Technical failure" attachedToRef="S_request" cancelActivity="true">
          <bpmn:outgoing>Flow_S_request_error_S_request_retry</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="student_project_err_TECHNICAL_FAILURE" />
        </bpmn:boundaryEvent>
        <bpmn:serviceTask id="S_request_retry" name="Count failed operation">
          <bpmn:incoming>Flow_S_request_error_S_request_retry</bpmn:incoming>
          <bpmn:outgoing>Flow_S_request_retry_S_request_retry_gate</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="S_request_retry_gate" name="Retry below three?" default="Flow_S_request_retry_gate_S_request_manual">
          <bpmn:incoming>Flow_S_request_retry_S_request_retry_gate</bpmn:incoming>
          <bpmn:outgoing>Flow_S_request_retry_gate_S_request_backoff</bpmn:outgoing>
          <bpmn:outgoing>Flow_S_request_retry_gate_S_request_manual</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:intermediateCatchEvent id="S_request_backoff" name="Retry after one minute">
          <bpmn:incoming>Flow_S_request_retry_gate_S_request_backoff</bpmn:incoming>
          <bpmn:outgoing>Flow_S_request_backoff_S_request</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>PT1M</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:userTask id="S_request_manual" name="Manual operation and confirmation">
          <bpmn:incoming>Flow_S_request_retry_gate_S_request_manual</bpmn:incoming>
          <bpmn:incoming>Flow_S_request_manual_gate_S_request_manual</bpmn:incoming>
          <bpmn:outgoing>Flow_S_request_manual_S_request_manual_gate</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="S_request_manual_gate" name="Manual operation confirmed?" default="Flow_S_request_manual_gate_S_accept">
          <bpmn:incoming>Flow_S_request_manual_S_request_manual_gate</bpmn:incoming>
          <bpmn:outgoing>Flow_S_request_manual_gate_S_request_manual</bpmn:outgoing>
          <bpmn:outgoing>Flow_S_request_manual_gate_S_accept</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_S_request_error_S_request_retry" sourceRef="S_request_error" targetRef="S_request_retry" />
        <bpmn:sequenceFlow id="Flow_S_request_retry_S_request_retry_gate" sourceRef="S_request_retry" targetRef="S_request_retry_gate" />
        <bpmn:sequenceFlow id="Flow_S_request_retry_gate_S_request_backoff" sourceRef="S_request_retry_gate" targetRef="S_request_backoff" name="Retry">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= S_request_failures &lt; 3</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_S_request_backoff_S_request" sourceRef="S_request_backoff" targetRef="S_request" />
        <bpmn:sequenceFlow id="Flow_S_request_retry_gate_S_request_manual" sourceRef="S_request_retry_gate" targetRef="S_request_manual" name="Manual fallback" />
        <bpmn:sequenceFlow id="Flow_S_request_manual_S_request_manual_gate" sourceRef="S_request_manual" targetRef="S_request_manual_gate" />
        <bpmn:sequenceFlow id="Flow_S_request_manual_gate_S_request_manual" sourceRef="S_request_manual_gate" targetRef="S_request_manual" name="Not yet">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualOperationDone = "no"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_S_request_manual_gate_S_accept" sourceRef="S_request_manual_gate" targetRef="S_accept" name="Confirmed" />
        <bpmn:userTask id="S_agree_expectations" name="Discuss Guide Conditions with Team">
          <bpmn:incoming>Flow_S_accept_gate_S_agree_expectations</bpmn:incoming>
          <bpmn:outgoing>Flow_S_agree_expectations_S_terms_gate</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="S_terms_gate" name="Team Accepts Conditions?" default="Flow_S_terms_gate_S_declined_error">
          <bpmn:incoming>Flow_S_agree_expectations_S_terms_gate</bpmn:incoming>
          <bpmn:outgoing>Flow_S_terms_gate_S_alloc_end</bpmn:outgoing>
          <bpmn:outgoing>Flow_S_terms_gate_S_declined_error</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_S_accept_gate_S_agree_expectations" sourceRef="S_accept_gate" targetRef="S_agree_expectations" name="Conditional acceptance">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= guideDecision = "conditional"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_S_agree_expectations_S_terms_gate" sourceRef="S_agree_expectations" targetRef="S_terms_gate" />
        <bpmn:sequenceFlow id="Flow_S_terms_gate_S_alloc_end" sourceRef="S_terms_gate" targetRef="S_alloc_end" name="Agreed">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= conditionsAccepted = true</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_S_terms_gate_S_declined_error" sourceRef="S_terms_gate" targetRef="S_declined_error" name="Not agreed" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="S_decline_catch" name="Decline or silence" attachedToRef="S_allocation" cancelActivity="true">
        <bpmn:outgoing>Flow_S_decline_catch_S_release_decline</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="student_project_err_GUIDE_DECLINED" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="S_release_decline" name="Release declined guide and exclude guide">
        <bpmn:incoming>Flow_S_decline_catch_S_release_decline</bpmn:incoming>
        <bpmn:outgoing>Flow_S_release_decline_S_attempt_gate</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="S_attempt_gate" name="Three allocation attempts reached?" default="Flow_S_attempt_gate_S_guide_rule">
        <bpmn:incoming>Flow_S_release_decline_S_attempt_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_attempt_gate_S_manual</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_attempt_gate_S_guide_rule</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="S_finalize" name="Record accepted allocation">
        <bpmn:incoming>Flow_S_allocation_S_finalize</bpmn:incoming>
        <bpmn:incoming>Flow_S_finalize_backoff_S_finalize</bpmn:incoming>
        <bpmn:outgoing>Flow_S_finalize_S_notify</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="S_notify" name="Notify student of confirmed allocation">
        <bpmn:incoming>Flow_S_finalize_S_notify</bpmn:incoming>
        <bpmn:incoming>Flow_S_finalize_manual_gate_S_notify</bpmn:incoming>
        <bpmn:incoming>Flow_S_notify_backoff_S_notify</bpmn:incoming>
        <bpmn:outgoing>Flow_S_notify_S_allocated</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:boundaryEvent id="S_finalize_error" name="Technical failure" attachedToRef="S_finalize" cancelActivity="true">
        <bpmn:outgoing>Flow_S_finalize_error_S_finalize_retry</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="student_project_err_TECHNICAL_FAILURE" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="S_finalize_retry" name="Count failed operation">
        <bpmn:incoming>Flow_S_finalize_error_S_finalize_retry</bpmn:incoming>
        <bpmn:outgoing>Flow_S_finalize_retry_S_finalize_retry_gate</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="S_finalize_retry_gate" name="Retry below three?" default="Flow_S_finalize_retry_gate_S_finalize_manual">
        <bpmn:incoming>Flow_S_finalize_retry_S_finalize_retry_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_finalize_retry_gate_S_finalize_backoff</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_finalize_retry_gate_S_finalize_manual</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="S_finalize_backoff" name="Retry after one minute">
        <bpmn:incoming>Flow_S_finalize_retry_gate_S_finalize_backoff</bpmn:incoming>
        <bpmn:outgoing>Flow_S_finalize_backoff_S_finalize</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>PT1M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="S_finalize_manual" name="Manual operation and confirmation">
        <bpmn:incoming>Flow_S_finalize_retry_gate_S_finalize_manual</bpmn:incoming>
        <bpmn:incoming>Flow_S_finalize_manual_gate_S_finalize_manual</bpmn:incoming>
        <bpmn:outgoing>Flow_S_finalize_manual_S_finalize_manual_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="S_finalize_manual_gate" name="Manual operation confirmed?" default="Flow_S_finalize_manual_gate_S_notify">
        <bpmn:incoming>Flow_S_finalize_manual_S_finalize_manual_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_finalize_manual_gate_S_finalize_manual</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_finalize_manual_gate_S_notify</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:boundaryEvent id="S_notify_error" name="Technical failure" attachedToRef="S_notify" cancelActivity="true">
        <bpmn:outgoing>Flow_S_notify_error_S_notify_retry</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="student_project_err_TECHNICAL_FAILURE" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="S_notify_retry" name="Count failed operation">
        <bpmn:incoming>Flow_S_notify_error_S_notify_retry</bpmn:incoming>
        <bpmn:outgoing>Flow_S_notify_retry_S_notify_retry_gate</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="S_notify_retry_gate" name="Retry below three?" default="Flow_S_notify_retry_gate_S_notify_manual">
        <bpmn:incoming>Flow_S_notify_retry_S_notify_retry_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_notify_retry_gate_S_notify_backoff</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_notify_retry_gate_S_notify_manual</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="S_notify_backoff" name="Retry after one minute">
        <bpmn:incoming>Flow_S_notify_retry_gate_S_notify_backoff</bpmn:incoming>
        <bpmn:outgoing>Flow_S_notify_backoff_S_notify</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>PT1M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="S_notify_manual" name="Manual operation and confirmation">
        <bpmn:incoming>Flow_S_notify_retry_gate_S_notify_manual</bpmn:incoming>
        <bpmn:incoming>Flow_S_notify_manual_gate_S_notify_manual</bpmn:incoming>
        <bpmn:outgoing>Flow_S_notify_manual_S_notify_manual_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="S_notify_manual_gate" name="Manual operation confirmed?" default="Flow_S_notify_manual_gate_S_allocated">
        <bpmn:incoming>Flow_S_notify_manual_S_notify_manual_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_notify_manual_gate_S_notify_manual</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_notify_manual_gate_S_allocated</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:boundaryEvent id="S_reserve_error" name="Technical failure" attachedToRef="S_reserve" cancelActivity="true">
        <bpmn:outgoing>Flow_S_reserve_error_S_reserve_retry</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="student_project_err_TECHNICAL_FAILURE" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="S_reserve_retry" name="Count failed operation">
        <bpmn:incoming>Flow_S_reserve_error_S_reserve_retry</bpmn:incoming>
        <bpmn:outgoing>Flow_S_reserve_retry_S_reserve_retry_gate</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="S_reserve_retry_gate" name="Retry below three?" default="Flow_S_reserve_retry_gate_S_reserve_manual">
        <bpmn:incoming>Flow_S_reserve_retry_S_reserve_retry_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_reserve_retry_gate_S_reserve_backoff</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_reserve_retry_gate_S_reserve_manual</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="S_reserve_backoff" name="Retry after one minute">
        <bpmn:incoming>Flow_S_reserve_retry_gate_S_reserve_backoff</bpmn:incoming>
        <bpmn:outgoing>Flow_S_reserve_backoff_S_reserve</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>PT1M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="S_reserve_manual" name="Manual operation and confirmation">
        <bpmn:incoming>Flow_S_reserve_retry_gate_S_reserve_manual</bpmn:incoming>
        <bpmn:incoming>Flow_S_reserve_manual_gate_S_reserve_manual</bpmn:incoming>
        <bpmn:outgoing>Flow_S_reserve_manual_S_reserve_manual_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="S_reserve_manual_gate" name="Manual operation confirmed?" default="Flow_S_reserve_manual_gate_S_reserve">
        <bpmn:incoming>Flow_S_reserve_manual_S_reserve_manual_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_reserve_manual_gate_S_reserve_manual</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_reserve_manual_gate_S_reserve</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="S_allocated" name="Project allocated">
        <bpmn:incoming>Flow_S_notify_S_allocated</bpmn:incoming>
        <bpmn:incoming>Flow_S_notify_manual_gate_S_allocated</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:startEvent id="S_post_start" name="Begin approved allocation">
        <bpmn:outgoing>Flow_S_post_start_S_guide_rule</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_S_post_start_S_guide_rule" sourceRef="S_post_start" targetRef="S_guide_rule" />
      <bpmn:endEvent id="S_post_lapsed" name="Allocation closed as lapsed">
        <bpmn:incoming>Flow_S_set_lapsed_S_post_lapsed</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="S_set_lapsed" name="Set allocation lapsed outcome">
        <bpmn:incoming>Flow_S_manual_gate_S_lapsed</bpmn:incoming>
        <bpmn:incoming>Flow_S_wait_limit_S_lapsed</bpmn:incoming>
        <bpmn:outgoing>Flow_S_set_lapsed_S_post_lapsed</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_S_set_lapsed_S_post_lapsed" sourceRef="S_set_lapsed" targetRef="S_post_lapsed" />
      <bpmn:sequenceFlow id="Flow_S_decline_catch_S_release_decline" sourceRef="S_decline_catch" targetRef="S_release_decline" />
      <bpmn:sequenceFlow id="Flow_S_release_decline_S_attempt_gate" sourceRef="S_release_decline" targetRef="S_attempt_gate" />
      <bpmn:sequenceFlow id="Flow_S_attempt_gate_S_manual" sourceRef="S_attempt_gate" targetRef="S_manual" name="Three attempts">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= guideAttempts &gt;= 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_attempt_gate_S_guide_rule" sourceRef="S_attempt_gate" targetRef="S_guide_rule" name="Retry" />
      <bpmn:sequenceFlow id="Flow_S_allocation_S_finalize" sourceRef="S_allocation" targetRef="S_finalize" />
      <bpmn:sequenceFlow id="Flow_S_finalize_S_notify" sourceRef="S_finalize" targetRef="S_notify" />
      <bpmn:sequenceFlow id="Flow_S_notify_S_allocated" sourceRef="S_notify" targetRef="S_allocated" />
      <bpmn:sequenceFlow id="Flow_S_finalize_error_S_finalize_retry" sourceRef="S_finalize_error" targetRef="S_finalize_retry" />
      <bpmn:sequenceFlow id="Flow_S_finalize_retry_S_finalize_retry_gate" sourceRef="S_finalize_retry" targetRef="S_finalize_retry_gate" />
      <bpmn:sequenceFlow id="Flow_S_finalize_retry_gate_S_finalize_backoff" sourceRef="S_finalize_retry_gate" targetRef="S_finalize_backoff" name="Retry">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= S_finalize_failures &lt; 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_finalize_backoff_S_finalize" sourceRef="S_finalize_backoff" targetRef="S_finalize" />
      <bpmn:sequenceFlow id="Flow_S_finalize_retry_gate_S_finalize_manual" sourceRef="S_finalize_retry_gate" targetRef="S_finalize_manual" name="Manual fallback" />
      <bpmn:sequenceFlow id="Flow_S_finalize_manual_S_finalize_manual_gate" sourceRef="S_finalize_manual" targetRef="S_finalize_manual_gate" />
      <bpmn:sequenceFlow id="Flow_S_finalize_manual_gate_S_finalize_manual" sourceRef="S_finalize_manual_gate" targetRef="S_finalize_manual" name="Not yet">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualOperationDone = "no"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_finalize_manual_gate_S_notify" sourceRef="S_finalize_manual_gate" targetRef="S_notify" name="Confirmed" />
      <bpmn:sequenceFlow id="Flow_S_notify_error_S_notify_retry" sourceRef="S_notify_error" targetRef="S_notify_retry" />
      <bpmn:sequenceFlow id="Flow_S_notify_retry_S_notify_retry_gate" sourceRef="S_notify_retry" targetRef="S_notify_retry_gate" />
      <bpmn:sequenceFlow id="Flow_S_notify_retry_gate_S_notify_backoff" sourceRef="S_notify_retry_gate" targetRef="S_notify_backoff" name="Retry">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= S_notify_failures &lt; 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_notify_backoff_S_notify" sourceRef="S_notify_backoff" targetRef="S_notify" />
      <bpmn:sequenceFlow id="Flow_S_notify_retry_gate_S_notify_manual" sourceRef="S_notify_retry_gate" targetRef="S_notify_manual" name="Manual fallback" />
      <bpmn:sequenceFlow id="Flow_S_notify_manual_S_notify_manual_gate" sourceRef="S_notify_manual" targetRef="S_notify_manual_gate" />
      <bpmn:sequenceFlow id="Flow_S_notify_manual_gate_S_notify_manual" sourceRef="S_notify_manual_gate" targetRef="S_notify_manual" name="Not yet">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualOperationDone = "no"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_notify_manual_gate_S_allocated" sourceRef="S_notify_manual_gate" targetRef="S_allocated" name="Confirmed" />
      <bpmn:sequenceFlow id="Flow_S_reserve_error_S_reserve_retry" sourceRef="S_reserve_error" targetRef="S_reserve_retry" />
      <bpmn:sequenceFlow id="Flow_S_reserve_retry_S_reserve_retry_gate" sourceRef="S_reserve_retry" targetRef="S_reserve_retry_gate" />
      <bpmn:sequenceFlow id="Flow_S_reserve_retry_gate_S_reserve_backoff" sourceRef="S_reserve_retry_gate" targetRef="S_reserve_backoff" name="Retry">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= S_reserve_failures &lt; 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_reserve_backoff_S_reserve" sourceRef="S_reserve_backoff" targetRef="S_reserve" />
      <bpmn:sequenceFlow id="Flow_S_reserve_retry_gate_S_reserve_manual" sourceRef="S_reserve_retry_gate" targetRef="S_reserve_manual" name="Manual fallback" />
      <bpmn:sequenceFlow id="Flow_S_reserve_manual_S_reserve_manual_gate" sourceRef="S_reserve_manual" targetRef="S_reserve_manual_gate" />
      <bpmn:sequenceFlow id="Flow_S_reserve_manual_gate_S_reserve_manual" sourceRef="S_reserve_manual_gate" targetRef="S_reserve_manual" name="Not yet">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualOperationDone = "no"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_reserve_manual_gate_S_reserve" sourceRef="S_reserve_manual_gate" targetRef="S_reserve" name="Confirmed" />
      <bpmn:sequenceFlow id="Flow_S_guide_rule_S_guide_available" sourceRef="S_guide_rule" targetRef="S_guide_available" />
      <bpmn:sequenceFlow id="Flow_S_guide_available_S_reserve" sourceRef="S_guide_available" targetRef="S_reserve" name="Available">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= guideAvailable = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_guide_available_S_manual" sourceRef="S_guide_available" targetRef="S_manual" name="None" />
      <bpmn:sequenceFlow id="Flow_S_manual_S_manual_gate" sourceRef="S_manual" targetRef="S_manual_gate" />
      <bpmn:sequenceFlow id="Flow_S_manual_gate_S_reserve" sourceRef="S_manual_gate" targetRef="S_reserve" name="Allocate">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualGuideDecision = "allocate"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_manual_gate_S_wait_limit" sourceRef="S_manual_gate" targetRef="S_wait_limit" name="Wait">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualGuideDecision = "wait"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_manual_gate_S_lapsed" sourceRef="S_manual_gate" targetRef="S_set_lapsed" name="Close" />
      <bpmn:sequenceFlow id="Flow_S_wait_limit_S_wait_count" sourceRef="S_wait_limit" targetRef="S_wait_count" name="Wait">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= waitRounds &lt; 7</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_wait_limit_S_lapsed" sourceRef="S_wait_limit" targetRef="S_set_lapsed" name="Waiting exhausted" />
      <bpmn:sequenceFlow id="Flow_S_wait_count_S_wait" sourceRef="S_wait_count" targetRef="S_wait" />
      <bpmn:sequenceFlow id="Flow_S_wait_S_guide_rule" sourceRef="S_wait" targetRef="S_guide_rule" />
      <bpmn:sequenceFlow id="Flow_S_reserve_S_allocation" sourceRef="S_reserve" targetRef="S_allocation" />
      <bpmn:subProcess id="S_withdraw_handler" name="Withdrawal during allocation" triggeredByEvent="true">
        <bpmn:laneSet id="S_withdraw_handler_lanes">
          <bpmn:lane id="S_withdraw_handler_lane_0" name="Project Management System">
            <bpmn:flowNodeRef>S_withdraw</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_compensate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_withdraw_result</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_withdraw_end</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="S_withdraw" name="Team or guide withdrawal" isInterrupting="true">
          <bpmn:outgoing>Flow_S_withdraw_S_compensate</bpmn:outgoing>
          <bpmn:messageEventDefinition messageRef="student_project_msg_withdrawal" />
        </bpmn:startEvent>
        <bpmn:intermediateThrowEvent id="S_compensate" name="Compensate guide slot">
          <bpmn:incoming>Flow_S_withdraw_S_compensate</bpmn:incoming>
          <bpmn:outgoing>Flow_S_compensate_S_withdraw_result</bpmn:outgoing>
          <bpmn:compensateEventDefinition activityRef="S_reserve" />
        </bpmn:intermediateThrowEvent>
        <bpmn:serviceTask id="S_withdraw_result" name="Record withdrawal and exclude leaving guide">
          <bpmn:incoming>Flow_S_compensate_S_withdraw_result</bpmn:incoming>
          <bpmn:outgoing>Flow_S_withdraw_result_S_withdraw_end</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="S_withdraw_end" name="Withdrawal handled">
          <bpmn:incoming>Flow_S_withdraw_result_S_withdraw_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_S_withdraw_S_compensate" sourceRef="S_withdraw" targetRef="S_compensate" />
        <bpmn:sequenceFlow id="Flow_S_compensate_S_withdraw_result" sourceRef="S_compensate" targetRef="S_withdraw_result" />
        <bpmn:sequenceFlow id="Flow_S_withdraw_result_S_withdraw_end" sourceRef="S_withdraw_result" targetRef="S_withdraw_end" />
      </bpmn:subProcess>
      <bpmn:association id="Assoc_S_reserve" sourceRef="S_reserve_comp" targetRef="S_release" associationDirection="One" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="S_post_gate" name="Allocation Result" default="Flow_S_post_gate_S_lapsed">
      <bpmn:incoming>Flow_S_post_approval_S_post_gate</bpmn:incoming>
      <bpmn:outgoing>Flow_S_post_gate_S_success</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_post_gate_S_withdraw_notice</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_post_gate_S_post_approval</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_post_gate_S_lapsed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="S_success" name="Project allocated">
      <bpmn:incoming>Flow_S_post_gate_S_success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="S_withdraw_notice" name="Notify withdrawn team">
      <bpmn:incoming>Flow_S_post_gate_S_withdraw_notice</bpmn:incoming>
      <bpmn:outgoing>Flow_S_withdraw_notice_S_withdrawn</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="S_withdrawn" name="Team withdrawn">
      <bpmn:incoming>Flow_S_withdraw_notice_S_withdrawn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_post_approval_S_post_gate" sourceRef="S_post_approval" targetRef="S_post_gate" />
    <bpmn:sequenceFlow id="Flow_S_post_gate_S_success" sourceRef="S_post_gate" targetRef="S_success" name="Allocated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= allocationOutcome = "allocated"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_post_gate_S_withdraw_notice" sourceRef="S_post_gate" targetRef="S_withdraw_notice" name="Team withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= allocationOutcome = "withdrawn"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_withdraw_notice_S_withdrawn" sourceRef="S_withdraw_notice" targetRef="S_withdrawn" />
    <bpmn:sequenceFlow id="Flow_S_post_gate_S_post_approval" sourceRef="S_post_gate" targetRef="S_post_approval" name="Guide left restart">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= allocationOutcome = "restart"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_post_gate_S_lapsed" sourceRef="S_post_gate" targetRef="S_lapsed" name="Lapsed" />
    <bpmn:subProcess id="S_proposal" name="Submit and Review Proposal">
      <bpmn:incoming>Flow_S_init_S_submit</bpmn:incoming>
      <bpmn:outgoing>Flow_S_proposal_S_post_approval</bpmn:outgoing>
      <bpmn:laneSet id="S_proposal_lanes">
        <bpmn:lane id="S_proposal_lane_0" name="Project Management System">
          <bpmn:flowNodeRef>S_sim_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_invalid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_similarity</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_validation_limit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_topic_limit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_topic_count</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_revision_count</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_validate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_new_limit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_late</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_valid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_reject_notice</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_new_count</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_errors</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="S_proposal_lane_1" name="Student / Team">
          <bpmn:flowNodeRef>S_deadline</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_new_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_revision_deadline</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_new_topic</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_revise</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_submit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_proposal_exit_S_lapsed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_proposal_exit_S_post_approval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_proposal_exit_S_rejected</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_proposal_start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_milestones</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_adjust_scope</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="S_proposal_lane_2" name="Review Committee including HoD">
          <bpmn:flowNodeRef>S_force</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_hod_end</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_hod_notify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_escalation_catch</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_force_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_revision_limit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_committee_gate</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="S_proposal_lane_3" name="Project Coordinator">
          <bpmn:flowNodeRef>S_screen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_late_decision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_match_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_screen_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_match</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_validation_resolution</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_late_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_validation_escalate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_resources</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_resource_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_recheck_resources</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_resource_result</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="S_sim_gate" name="Similarity above threshold?" default="Flow_S_sim_gate_S_review">
        <bpmn:incoming>Flow_S_similarity_S_sim_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_sim_gate_S_match</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_sim_gate_S_review</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:boundaryEvent id="S_deadline" name="Submission deadline" attachedToRef="S_submit" cancelActivity="true">
        <bpmn:outgoing>Flow_S_deadline_S_late</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="S_invalid" name="Invalid team">
        <bpmn:incoming>Flow_S_valid_S_invalid</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="student_project_err_INVALID_TEAM" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="S_similarity" name="Check duplicate and similarity score">
        <bpmn:incoming>Flow_S_resource_gate_S_similarity</bpmn:incoming>
        <bpmn:incoming>Flow_S_resource_result_S_similarity</bpmn:incoming>
        <bpmn:outgoing>Flow_S_similarity_S_sim_gate</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="S_force" name="Final committee approve or reject">
        <bpmn:incoming>Flow_S_revision_limit_S_force</bpmn:incoming>
        <bpmn:outgoing>Flow_S_force_S_force_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="S_validation_limit" name="Attempts below two?" default="Flow_S_validation_limit_S_validation_escalate">
        <bpmn:incoming>Flow_S_valid_S_validation_limit</bpmn:incoming>
        <bpmn:outgoing>Flow_S_validation_limit_S_errors</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_validation_limit_S_validation_escalate</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="S_hod_end" name="HoD informed">
        <bpmn:incoming>Flow_S_hod_notify_S_hod_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="S_topic_limit" name="Topic modifications below two?" default="Flow_S_topic_limit_S_reject_notice">
        <bpmn:incoming>Flow_S_match_gate_S_topic_limit</bpmn:incoming>
        <bpmn:outgoing>Flow_S_topic_limit_S_topic_count</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_topic_limit_S_reject_notice</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="S_new_gate" name="New topic decision" default="Flow_S_new_gate_S_rejected">
        <bpmn:incoming>Flow_S_new_topic_S_new_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_new_gate_S_new_count</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_new_gate_S_rejected</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="S_topic_count" name="Count topic modification">
        <bpmn:incoming>Flow_S_topic_limit_S_topic_count</bpmn:incoming>
        <bpmn:outgoing>Flow_S_topic_count_S_submit</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="S_revision_deadline" name="Seven day revision deadline" attachedToRef="S_revise" cancelActivity="true">
        <bpmn:outgoing>Flow_S_revision_deadline_S_lapsed</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="S_revision_count" name="Arrange Mentoring Meeting and Count Revision">
        <bpmn:incoming>Flow_S_revision_limit_S_revision_count</bpmn:incoming>
        <bpmn:outgoing>Flow_S_revision_count_S_revise</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="S_screen" name="Screen proposal">
        <bpmn:incoming>Flow_S_valid_S_screen</bpmn:incoming>
        <bpmn:outgoing>Flow_S_screen_S_screen_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:businessRuleTask id="S_validate" name="Validate fields and team rules">
        <bpmn:incoming>Flow_S_submit_S_validate</bpmn:incoming>
        <bpmn:incoming>Flow_S_revise_S_validate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_validate_S_valid</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:sendTask id="S_hod_notify" name="Send HoD escalation record">
        <bpmn:incoming>Flow_S_escalation_catch_S_hod_notify</bpmn:incoming>
        <bpmn:outgoing>Flow_S_hod_notify_S_hod_end</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="S_new_limit" name="One new topic available?" default="Flow_S_new_limit_S_rejected">
        <bpmn:incoming>Flow_S_reject_notice_S_new_limit</bpmn:incoming>
        <bpmn:outgoing>Flow_S_new_limit_S_new_topic</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_new_limit_S_rejected</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="S_late" name="Flag and notify late submission">
        <bpmn:incoming>Flow_S_deadline_S_late</bpmn:incoming>
        <bpmn:outgoing>Flow_S_late_S_late_decision</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:boundaryEvent id="S_escalation_catch" name="HoD receives escalation" attachedToRef="S_review" cancelActivity="false">
        <bpmn:outgoing>Flow_S_escalation_catch_S_hod_notify</bpmn:outgoing>
        <bpmn:escalationEventDefinition escalationRef="S_REVIEW_DELAY" />
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="S_valid" name="Validation outcome" default="Flow_S_valid_S_screen">
        <bpmn:incoming>Flow_S_validate_S_valid</bpmn:incoming>
        <bpmn:outgoing>Flow_S_valid_S_invalid</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_valid_S_validation_limit</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_valid_S_screen</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="S_new_topic" name="Submit one new topic?">
        <bpmn:incoming>Flow_S_new_limit_S_new_topic</bpmn:incoming>
        <bpmn:outgoing>Flow_S_new_topic_S_new_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="S_late_decision" name="Approve late submission?">
        <bpmn:incoming>Flow_S_late_S_late_decision</bpmn:incoming>
        <bpmn:outgoing>Flow_S_late_decision_S_late_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="S_reject_notice" name="Send rejection reasons">
        <bpmn:incoming>Flow_S_validation_resolution_S_reject_notice</bpmn:incoming>
        <bpmn:incoming>Flow_S_screen_gate_S_reject_notice</bpmn:incoming>
        <bpmn:incoming>Flow_S_match_gate_S_reject_notice</bpmn:incoming>
        <bpmn:incoming>Flow_S_topic_limit_S_reject_notice</bpmn:incoming>
        <bpmn:incoming>Flow_S_committee_gate_S_reject_notice</bpmn:incoming>
        <bpmn:incoming>Flow_S_force_gate_S_reject_notice</bpmn:incoming>
        <bpmn:incoming>Flow_S_resource_gate_S_reject_notice</bpmn:incoming>
        <bpmn:incoming>Flow_S_resource_result_S_reject_notice</bpmn:incoming>
        <bpmn:outgoing>Flow_S_reject_notice_S_new_limit</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="S_match_gate" name="Match decision" default="Flow_S_match_gate_S_reject_notice">
        <bpmn:incoming>Flow_S_match_S_match_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_match_gate_S_review</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_match_gate_S_topic_limit</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_match_gate_S_reject_notice</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="S_screen_gate" name="Screen result" default="Flow_S_screen_gate_S_reject_notice">
        <bpmn:incoming>Flow_S_screen_S_screen_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_screen_gate_S_similarity</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_screen_gate_S_reject_notice</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="S_force_gate" name="Final decision" default="Flow_S_force_gate_S_reject_notice">
        <bpmn:incoming>Flow_S_force_S_force_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_force_gate_S_guide_rule</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_force_gate_S_reject_notice</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="S_revision_limit" name="Revision cycles below two?" default="Flow_S_revision_limit_S_force">
        <bpmn:incoming>Flow_S_committee_gate_S_revision_limit</bpmn:incoming>
        <bpmn:outgoing>Flow_S_revision_limit_S_revision_count</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_revision_limit_S_force</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="S_revise" name="Revise Scope with Coordinator Guidance">
        <bpmn:incoming>Flow_S_revision_count_S_revise</bpmn:incoming>
        <bpmn:outgoing>Flow_S_revise_S_validate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="S_match" name="Review duplicate match">
        <bpmn:incoming>Flow_S_sim_gate_S_match</bpmn:incoming>
        <bpmn:outgoing>Flow_S_match_S_match_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="S_new_count" name="Reset counters for one new topic">
        <bpmn:incoming>Flow_S_new_gate_S_new_count</bpmn:incoming>
        <bpmn:outgoing>Flow_S_new_count_S_submit</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:subProcess id="S_review" name="Committee review with SLA">
        <bpmn:incoming>Flow_S_milestones_S_review</bpmn:incoming>
        <bpmn:outgoing>Flow_S_review_S_committee_gate</bpmn:outgoing>
        <bpmn:laneSet id="S_review_lanes">
          <bpmn:lane id="S_review_lane_0" name="Review Committee including HoD">
            <bpmn:flowNodeRef>S_review_start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_committee</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_review_end</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_reminder_timer</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_hod_timer</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_escalate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_escalate_end</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="S_review_lane_1" name="Project Management System">
            <bpmn:flowNodeRef>S_remind</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>S_remind_end</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="S_review_start" name="Review starts">
          <bpmn:outgoing>Flow_S_review_start_S_committee</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="S_committee" name="Evaluate proposal">
          <bpmn:incoming>Flow_S_review_start_S_committee</bpmn:incoming>
          <bpmn:outgoing>Flow_S_committee_S_review_end</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="S_review_end" name="Decision captured">
          <bpmn:incoming>Flow_S_committee_S_review_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_S_review_start_S_committee" sourceRef="S_review_start" targetRef="S_committee" />
        <bpmn:sequenceFlow id="Flow_S_committee_S_review_end" sourceRef="S_committee" targetRef="S_review_end" />
        <bpmn:boundaryEvent id="S_reminder_timer" name="Review reminder after 2 days" attachedToRef="S_committee" cancelActivity="false">
          <bpmn:outgoing>Flow_S_reminder_timer_S_remind</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>P2D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sendTask id="S_remind" name="Send committee reminder">
          <bpmn:incoming>Flow_S_reminder_timer_S_remind</bpmn:incoming>
          <bpmn:outgoing>Flow_S_remind_S_remind_end</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:endEvent id="S_remind_end" name="Reminder sent">
          <bpmn:incoming>Flow_S_remind_S_remind_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_S_reminder_timer_S_remind" sourceRef="S_reminder_timer" targetRef="S_remind" />
        <bpmn:sequenceFlow id="Flow_S_remind_S_remind_end" sourceRef="S_remind" targetRef="S_remind_end" />
        <bpmn:boundaryEvent id="S_hod_timer" name="Escalate after 4 days" attachedToRef="S_committee" cancelActivity="false">
          <bpmn:outgoing>Flow_S_hod_timer_S_escalate</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>P4D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:intermediateThrowEvent id="S_escalate" name="Raise HoD escalation">
          <bpmn:incoming>Flow_S_hod_timer_S_escalate</bpmn:incoming>
          <bpmn:outgoing>Flow_S_escalate_S_escalate_end</bpmn:outgoing>
          <bpmn:escalationEventDefinition escalationRef="S_REVIEW_DELAY" />
        </bpmn:intermediateThrowEvent>
        <bpmn:endEvent id="S_escalate_end" name="Escalation raised">
          <bpmn:incoming>Flow_S_escalate_S_escalate_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_S_hod_timer_S_escalate" sourceRef="S_hod_timer" targetRef="S_escalate" />
        <bpmn:sequenceFlow id="Flow_S_escalate_S_escalate_end" sourceRef="S_escalate" targetRef="S_escalate_end" />
      </bpmn:subProcess>
      <bpmn:userTask id="S_submit" name="Submit or correct proposal">
        <bpmn:incoming>Flow_S_errors_S_submit</bpmn:incoming>
        <bpmn:incoming>Flow_S_validation_resolution_S_submit</bpmn:incoming>
        <bpmn:incoming>Flow_S_late_gate_S_submit</bpmn:incoming>
        <bpmn:incoming>Flow_S_topic_count_S_submit</bpmn:incoming>
        <bpmn:incoming>Flow_S_new_count_S_submit</bpmn:incoming>
        <bpmn:incoming>Flow_S_proposal_start_S_submit</bpmn:incoming>
        <bpmn:outgoing>Flow_S_submit_S_validate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="S_errors" name="Return field error list">
        <bpmn:incoming>Flow_S_validation_limit_S_errors</bpmn:incoming>
        <bpmn:outgoing>Flow_S_errors_S_submit</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="S_validation_resolution" name="Coordinator resolution" default="Flow_S_validation_resolution_S_reject_notice">
        <bpmn:incoming>Flow_S_validation_escalate_S_validation_resolution</bpmn:incoming>
        <bpmn:outgoing>Flow_S_validation_resolution_S_submit</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_validation_resolution_S_reject_notice</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="S_late_gate" name="Late permission" default="Flow_S_late_gate_S_lapsed">
        <bpmn:incoming>Flow_S_late_decision_S_late_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_late_gate_S_submit</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_late_gate_S_lapsed</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="S_committee_gate" name="Committee outcome" default="Flow_S_committee_gate_S_reject_notice">
        <bpmn:incoming>Flow_S_review_S_committee_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_committee_gate_S_guide_rule</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_committee_gate_S_revision_limit</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_committee_gate_S_reject_notice</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="S_validation_escalate" name="Resolve validation after two attempts">
        <bpmn:incoming>Flow_S_validation_limit_S_validation_escalate</bpmn:incoming>
        <bpmn:outgoing>Flow_S_validation_escalate_S_validation_resolution</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_S_escalation_catch_S_hod_notify" sourceRef="S_escalation_catch" targetRef="S_hod_notify" />
      <bpmn:sequenceFlow id="Flow_S_hod_notify_S_hod_end" sourceRef="S_hod_notify" targetRef="S_hod_end" />
      <bpmn:sequenceFlow id="Flow_S_submit_S_validate" sourceRef="S_submit" targetRef="S_validate" />
      <bpmn:sequenceFlow id="Flow_S_validate_S_valid" sourceRef="S_validate" targetRef="S_valid" />
      <bpmn:sequenceFlow id="Flow_S_valid_S_invalid" sourceRef="S_valid" targetRef="S_invalid" name="Invalid team">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= teamValid = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_valid_S_validation_limit" sourceRef="S_valid" targetRef="S_validation_limit" name="Invalid fields">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= teamValid = true and fieldsValid = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_valid_S_screen" sourceRef="S_valid" targetRef="S_screen" name="Valid" />
      <bpmn:sequenceFlow id="Flow_S_validation_limit_S_errors" sourceRef="S_validation_limit" targetRef="S_errors" name="Correct">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationAttempts &lt; 2</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_validation_limit_S_validation_escalate" sourceRef="S_validation_limit" targetRef="S_validation_escalate" name="Escalate" />
      <bpmn:sequenceFlow id="Flow_S_errors_S_submit" sourceRef="S_errors" targetRef="S_submit" />
      <bpmn:sequenceFlow id="Flow_S_validation_escalate_S_validation_resolution" sourceRef="S_validation_escalate" targetRef="S_validation_resolution" />
      <bpmn:sequenceFlow id="Flow_S_validation_resolution_S_submit" sourceRef="S_validation_resolution" targetRef="S_submit" name="Correct">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationResolution = "correct"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_validation_resolution_S_reject_notice" sourceRef="S_validation_resolution" targetRef="S_reject_notice" name="Reject" />
      <bpmn:sequenceFlow id="Flow_S_deadline_S_late" sourceRef="S_deadline" targetRef="S_late" />
      <bpmn:sequenceFlow id="Flow_S_late_S_late_decision" sourceRef="S_late" targetRef="S_late_decision" />
      <bpmn:sequenceFlow id="Flow_S_late_decision_S_late_gate" sourceRef="S_late_decision" targetRef="S_late_gate" />
      <bpmn:sequenceFlow id="Flow_S_late_gate_S_submit" sourceRef="S_late_gate" targetRef="S_submit" name="Allowed">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= lateDecision = "allow"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_late_gate_S_lapsed" sourceRef="S_late_gate" targetRef="S_proposal_exit_S_lapsed" name="Lapse" />
      <bpmn:endEvent id="S_proposal_exit_S_lapsed" name="Proposal lapsed">
        <bpmn:incoming>Flow_S_late_gate_S_lapsed</bpmn:incoming>
        <bpmn:incoming>Flow_S_revision_deadline_S_lapsed</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="student_project_err_EXIT_S_lapsed" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S_screen_S_screen_gate" sourceRef="S_screen" targetRef="S_screen_gate" />
      <bpmn:sequenceFlow id="Flow_S_screen_gate_S_similarity" sourceRef="S_screen_gate" targetRef="S_resources" name="Pass">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= screenDecision = "pass"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_screen_gate_S_reject_notice" sourceRef="S_screen_gate" targetRef="S_reject_notice" name="Reject" />
      <bpmn:sequenceFlow id="Flow_S_similarity_S_sim_gate" sourceRef="S_similarity" targetRef="S_sim_gate" />
      <bpmn:sequenceFlow id="Flow_S_sim_gate_S_match" sourceRef="S_sim_gate" targetRef="S_match" name="Match">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= similarityScore &gt; similarityThreshold</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_sim_gate_S_review" sourceRef="S_sim_gate" targetRef="S_milestones" name="Clear" />
      <bpmn:sequenceFlow id="Flow_S_match_S_match_gate" sourceRef="S_match" targetRef="S_match_gate" />
      <bpmn:sequenceFlow id="Flow_S_match_gate_S_review" sourceRef="S_match_gate" targetRef="S_milestones" name="Cleared">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= duplicateDecision = "clear"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_match_gate_S_topic_limit" sourceRef="S_match_gate" targetRef="S_topic_limit" name="Modify">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= duplicateDecision = "modify"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_match_gate_S_reject_notice" sourceRef="S_match_gate" targetRef="S_reject_notice" name="Reject" />
      <bpmn:sequenceFlow id="Flow_S_topic_limit_S_topic_count" sourceRef="S_topic_limit" targetRef="S_topic_count" name="Modify">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= topicChanges &lt; 2</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_topic_limit_S_reject_notice" sourceRef="S_topic_limit" targetRef="S_reject_notice" name="Limit reached" />
      <bpmn:sequenceFlow id="Flow_S_topic_count_S_submit" sourceRef="S_topic_count" targetRef="S_submit" />
      <bpmn:sequenceFlow id="Flow_S_review_S_committee_gate" sourceRef="S_review" targetRef="S_committee_gate" />
      <bpmn:sequenceFlow id="Flow_S_committee_gate_S_guide_rule" sourceRef="S_committee_gate" targetRef="S_proposal_exit_S_post_approval" name="Approved">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "approve"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:endEvent id="S_proposal_exit_S_post_approval" name="Approved">
        <bpmn:incoming>Flow_S_committee_gate_S_guide_rule</bpmn:incoming>
        <bpmn:incoming>Flow_S_force_gate_S_guide_rule</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S_committee_gate_S_revision_limit" sourceRef="S_committee_gate" targetRef="S_revision_limit" name="Revise">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "revise"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_committee_gate_S_reject_notice" sourceRef="S_committee_gate" targetRef="S_reject_notice" name="Rejected" />
      <bpmn:sequenceFlow id="Flow_S_revision_limit_S_revision_count" sourceRef="S_revision_limit" targetRef="S_revision_count" name="Revise">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= revisionCycles &lt; 2</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_revision_limit_S_force" sourceRef="S_revision_limit" targetRef="S_force" name="Final decision" />
      <bpmn:sequenceFlow id="Flow_S_revision_count_S_revise" sourceRef="S_revision_count" targetRef="S_revise" />
      <bpmn:sequenceFlow id="Flow_S_revise_S_validate" sourceRef="S_revise" targetRef="S_validate" />
      <bpmn:sequenceFlow id="Flow_S_revision_deadline_S_lapsed" sourceRef="S_revision_deadline" targetRef="S_proposal_exit_S_lapsed" />
      <bpmn:sequenceFlow id="Flow_S_force_S_force_gate" sourceRef="S_force" targetRef="S_force_gate" />
      <bpmn:sequenceFlow id="Flow_S_force_gate_S_guide_rule" sourceRef="S_force_gate" targetRef="S_proposal_exit_S_post_approval" name="Approved">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "approve"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_force_gate_S_reject_notice" sourceRef="S_force_gate" targetRef="S_reject_notice" name="Rejected" />
      <bpmn:sequenceFlow id="Flow_S_reject_notice_S_new_limit" sourceRef="S_reject_notice" targetRef="S_new_limit" />
      <bpmn:sequenceFlow id="Flow_S_new_limit_S_new_topic" sourceRef="S_new_limit" targetRef="S_new_topic" name="One new topic">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= newTopics &lt; 1</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_new_limit_S_rejected" sourceRef="S_new_limit" targetRef="S_proposal_exit_S_rejected" name="No new topic left" />
      <bpmn:endEvent id="S_proposal_exit_S_rejected" name="Proposal rejected">
        <bpmn:incoming>Flow_S_new_limit_S_rejected</bpmn:incoming>
        <bpmn:incoming>Flow_S_new_gate_S_rejected</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="student_project_err_EXIT_S_rejected" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S_new_topic_S_new_gate" sourceRef="S_new_topic" targetRef="S_new_gate" />
      <bpmn:sequenceFlow id="Flow_S_new_gate_S_new_count" sourceRef="S_new_gate" targetRef="S_new_count" name="Yes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= newTopicDecision = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_new_gate_S_rejected" sourceRef="S_new_gate" targetRef="S_proposal_exit_S_rejected" name="No" />
      <bpmn:sequenceFlow id="Flow_S_new_count_S_submit" sourceRef="S_new_count" targetRef="S_submit" />
      <bpmn:startEvent id="S_proposal_start" name="Start">
        <bpmn:outgoing>Flow_S_proposal_start_S_submit</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_S_proposal_start_S_submit" sourceRef="S_proposal_start" targetRef="S_submit" />
      <bpmn:userTask id="S_milestones" name="Confirm Project Milestones">
        <bpmn:incoming>Flow_S_sim_gate_S_review</bpmn:incoming>
        <bpmn:incoming>Flow_S_match_gate_S_review</bpmn:incoming>
        <bpmn:outgoing>Flow_S_milestones_S_review</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_S_milestones_S_review" sourceRef="S_milestones" targetRef="S_review" />
      <bpmn:userTask id="S_resources" name="Check Required Resources">
        <bpmn:incoming>Flow_S_screen_gate_S_similarity</bpmn:incoming>
        <bpmn:outgoing>Flow_S_resources_S_similarity</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_S_resources_S_similarity" sourceRef="S_resources" targetRef="S_resource_gate" />
      <bpmn:exclusiveGateway id="S_resource_gate" name="Resources Available?" default="Flow_S_resource_gate_S_reject_notice">
        <bpmn:incoming>Flow_S_resources_S_similarity</bpmn:incoming>
        <bpmn:outgoing>Flow_S_resource_gate_S_similarity</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_resource_gate_S_adjust_scope</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_resource_gate_S_reject_notice</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="S_adjust_scope" name="Adapt Scope to Available Resources">
        <bpmn:incoming>Flow_S_resource_gate_S_adjust_scope</bpmn:incoming>
        <bpmn:outgoing>Flow_S_adjust_scope_S_recheck_resources</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="S_recheck_resources" name="Review Adjusted Resource Plan">
        <bpmn:incoming>Flow_S_adjust_scope_S_recheck_resources</bpmn:incoming>
        <bpmn:outgoing>Flow_S_recheck_resources_S_resource_result</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="S_resource_result" name="Adjusted Plan Feasible?" default="Flow_S_resource_result_S_reject_notice">
        <bpmn:incoming>Flow_S_recheck_resources_S_resource_result</bpmn:incoming>
        <bpmn:outgoing>Flow_S_resource_result_S_similarity</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_resource_result_S_reject_notice</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_S_resource_gate_S_similarity" sourceRef="S_resource_gate" targetRef="S_similarity" name="Available">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= resourceDecision = "available"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_resource_gate_S_adjust_scope" sourceRef="S_resource_gate" targetRef="S_adjust_scope" name="Can adapt">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= resourceDecision = "adapt"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_resource_gate_S_reject_notice" sourceRef="S_resource_gate" targetRef="S_reject_notice" name="Not feasible" />
      <bpmn:sequenceFlow id="Flow_S_adjust_scope_S_recheck_resources" sourceRef="S_adjust_scope" targetRef="S_recheck_resources" />
      <bpmn:sequenceFlow id="Flow_S_recheck_resources_S_resource_result" sourceRef="S_recheck_resources" targetRef="S_resource_result" />
      <bpmn:sequenceFlow id="Flow_S_resource_result_S_similarity" sourceRef="S_resource_result" targetRef="S_similarity" name="Feasible">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= resourcePlanFeasible = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S_resource_result_S_reject_notice" sourceRef="S_resource_result" targetRef="S_reject_notice" name="Still not feasible" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="S_proposal_catch_S_lapsed" name="Proposal lapsed" attachedToRef="S_proposal" cancelActivity="true">
      <bpmn:outgoing>Flow_S_proposal_catch_S_lapsed_S_lapsed</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="student_project_err_EXIT_S_lapsed" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_S_proposal_catch_S_lapsed_S_lapsed" sourceRef="S_proposal_catch_S_lapsed" targetRef="S_lapsed" />
    <bpmn:sequenceFlow id="Flow_S_proposal_S_post_approval" sourceRef="S_proposal" targetRef="S_post_approval" />
    <bpmn:boundaryEvent id="S_proposal_catch_S_rejected" name="Proposal rejected" attachedToRef="S_proposal" cancelActivity="true">
      <bpmn:outgoing>Flow_S_proposal_catch_S_rejected_S_rejected</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="student_project_err_EXIT_S_rejected" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_S_proposal_catch_S_rejected_S_rejected" sourceRef="S_proposal_catch_S_rejected" targetRef="S_rejected" />
  </bpmn:process>
  <bpmn:collaboration id="student_project_collab">
    <bpmn:participant id="student_project_pool" name="Assignment 1 - Student Project Approval and Allocation" processRef="student_project" />
