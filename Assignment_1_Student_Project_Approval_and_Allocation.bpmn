<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="A1_Definitions" targetNamespace="https://example.org/bpmn/assignments" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="A1_Student_Project" name="Student Project Approval and Allocation" isExecutable="false">
    <bpmn:laneSet id="A1_Lanes">
      <bpmn:lane id="A1_SupportLane" name="Coordinator / support">
        <bpmn:flowNodeRef>A1_Student_Project_newlimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_newtopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_wg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_newchoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A1_MainLane" name="Project department">
        <bpmn:flowNodeRef>A1_Student_Project_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_allocation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_rc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Student_Project_pc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A1_Student_Project_s" name="Proposal started">
      <bpmn:outgoing>A1_Student_Project_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="A1_Student_Project_newlimit" name="New topic already used?">
      <bpmn:incoming>A1_Student_Project_Flow_10</bpmn:incoming>
      <bpmn:outgoing>A1_Student_Project_Flow_11</bpmn:outgoing>
      <bpmn:outgoing>A1_Student_Project_Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A1_Student_Project_newtopic" name="Consider and record one new topic">
      <bpmn:incoming>A1_Student_Project_Flow_12</bpmn:incoming>
      <bpmn:outgoing>A1_Student_Project_Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A1_Student_Project_done" name="Project allocated">
      <bpmn:incoming>A1_Student_Project_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="A1_Student_Project_closed" name="Proposal closed">
      <bpmn:incoming>A1_Student_Project_Flow_5</bpmn:incoming>
      <bpmn:incoming>A1_Student_Project_Flow_11</bpmn:incoming>
      <bpmn:incoming>A1_Student_Project_Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="A1_Student_Project_release" name="Release guide reservation">
      <bpmn:incoming>A1_Student_Project_Flow_6</bpmn:incoming>
      <bpmn:outgoing>A1_Student_Project_Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="A1_Student_Project_wg" name="Team continuing?">
      <bpmn:incoming>A1_Student_Project_Flow_7</bpmn:incoming>
      <bpmn:outgoing>A1_Student_Project_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>A1_Student_Project_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="A1_Student_Project_withdrawn" name="Team withdrawn">
      <bpmn:incoming>A1_Student_Project_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="A1_Student_Project_newchoice" name="Submit new topic?">
      <bpmn:incoming>A1_Student_Project_Flow_13</bpmn:incoming>
      <bpmn:outgoing>A1_Student_Project_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>A1_Student_Project_Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="A1_proposal" name="Submit and check proposal">
      <bpmn:incoming>A1_Student_Project_Flow_1</bpmn:incoming>
      <bpmn:incoming>A1_Student_Project_Flow_14</bpmn:incoming>
      <bpmn:outgoing>A1_Student_Project_Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="A1_proposal_p0" name="Start">
        <bpmn:outgoing>A1_proposal_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="A1_proposal_submit" name="Student submits proposal">
        <bpmn:incoming>A1_proposal_Flow_1</bpmn:incoming>
        <bpmn:incoming>A1_proposal_Flow_6</bpmn:incoming>
        <bpmn:incoming>A1_proposal_Flow_15</bpmn:incoming>
        <bpmn:incoming>A1_proposal_Flow_18</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="A1_proposal_validate" name="Validate fields and team rules">
        <bpmn:incoming>A1_proposal_Flow_2</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A1_proposal_valid" name="Details valid?">
        <bpmn:incoming>A1_proposal_Flow_3</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_4</bpmn:outgoing>
        <bpmn:outgoing>A1_proposal_Flow_5</bpmn:outgoing>
        <bpmn:outgoing>A1_proposal_Flow_7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A1_proposal_screen" name="Coordinator checks scope and resources">
        <bpmn:incoming>A1_proposal_Flow_4</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="A1_proposal_similar" name="Check topic similarity">
        <bpmn:incoming>A1_proposal_Flow_21</bpmn:incoming>
        <bpmn:incoming>A1_proposal_Flow_24</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A1_proposal_match" name="Similar topic?">
        <bpmn:incoming>A1_proposal_Flow_8</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_9</bpmn:outgoing>
        <bpmn:outgoing>A1_proposal_Flow_10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A1_proposal_pdone" name="Ready for review">
        <bpmn:incoming>A1_proposal_Flow_9</bpmn:incoming>
        <bpmn:incoming>A1_proposal_Flow_12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="A1_proposal_correct" name="Correct details with coordinator">
        <bpmn:documentation>Coordinator reviews repeated errors with the student and permits resubmission only when corrected; close an invalid team through the validation result.</bpmn:documentation>
        <bpmn:incoming>A1_proposal_Flow_5</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="A1_proposal_invalid" name="Invalid team: close proposal">
        <bpmn:incoming>A1_proposal_Flow_7</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="A1_error_CLOSED" />
      </bpmn:endEvent>
      <bpmn:userTask id="A1_proposal_topic" name="Coordinator reviews topic match">
        <bpmn:incoming>A1_proposal_Flow_10</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A1_proposal_tg" name="Topic acceptable?">
        <bpmn:incoming>A1_proposal_Flow_11</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_12</bpmn:outgoing>
        <bpmn:outgoing>A1_proposal_Flow_13</bpmn:outgoing>
        <bpmn:outgoing>A1_proposal_Flow_14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A1_proposal_topicchange" name="Student changes topic">
        <bpmn:incoming>A1_proposal_Flow_13</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="A1_proposal_preject" name="Proposal cannot proceed">
        <bpmn:incoming>A1_proposal_Flow_14</bpmn:incoming>
        <bpmn:incoming>A1_proposal_Flow_19</bpmn:incoming>
        <bpmn:incoming>A1_proposal_Flow_25</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="A1_error_CLOSED" />
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="A1_proposal_late" name="7-day submission deadline" attachedToRef="A1_proposal_submit">
        <bpmn:outgoing>A1_proposal_Flow_16</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A1_proposal_latecheck" name="Coordinator decides late request">
        <bpmn:incoming>A1_proposal_Flow_16</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A1_proposal_lg" name="Late request approved?">
        <bpmn:incoming>A1_proposal_Flow_17</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_18</bpmn:outgoing>
        <bpmn:outgoing>A1_proposal_Flow_19</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="A1_proposal_resources" name="Resources available?">
        <bpmn:incoming>A1_proposal_Flow_20</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_21</bpmn:outgoing>
        <bpmn:outgoing>A1_proposal_Flow_22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A1_proposal_adapt" name="Agree adjusted scope and resources">
        <bpmn:incoming>A1_proposal_Flow_22</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A1_proposal_feasible" name="Adjusted plan feasible?">
        <bpmn:incoming>A1_proposal_Flow_23</bpmn:incoming>
        <bpmn:outgoing>A1_proposal_Flow_24</bpmn:outgoing>
        <bpmn:outgoing>A1_proposal_Flow_25</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="A1_proposal_Flow_1" sourceRef="A1_proposal_p0" targetRef="A1_proposal_submit" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_2" sourceRef="A1_proposal_submit" targetRef="A1_proposal_validate" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_3" sourceRef="A1_proposal_validate" targetRef="A1_proposal_valid" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_4" name="Valid" sourceRef="A1_proposal_valid" targetRef="A1_proposal_screen" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_5" name="Missing details" sourceRef="A1_proposal_valid" targetRef="A1_proposal_correct" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_6" sourceRef="A1_proposal_correct" targetRef="A1_proposal_submit" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_7" name="Invalid team" sourceRef="A1_proposal_valid" targetRef="A1_proposal_invalid" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_8" sourceRef="A1_proposal_similar" targetRef="A1_proposal_match" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_9" name="No" sourceRef="A1_proposal_match" targetRef="A1_proposal_pdone" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_10" name="Yes" sourceRef="A1_proposal_match" targetRef="A1_proposal_topic" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_11" sourceRef="A1_proposal_topic" targetRef="A1_proposal_tg" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_12" name="Accept" sourceRef="A1_proposal_tg" targetRef="A1_proposal_pdone" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_13" name="Change topic" sourceRef="A1_proposal_tg" targetRef="A1_proposal_topicchange" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_14" name="Reject" sourceRef="A1_proposal_tg" targetRef="A1_proposal_preject" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_15" sourceRef="A1_proposal_topicchange" targetRef="A1_proposal_submit" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_16" sourceRef="A1_proposal_late" targetRef="A1_proposal_latecheck" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_17" sourceRef="A1_proposal_latecheck" targetRef="A1_proposal_lg" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_18" name="Yes" sourceRef="A1_proposal_lg" targetRef="A1_proposal_submit" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_19" name="No" sourceRef="A1_proposal_lg" targetRef="A1_proposal_preject" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_20" sourceRef="A1_proposal_screen" targetRef="A1_proposal_resources" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_21" name="Yes" sourceRef="A1_proposal_resources" targetRef="A1_proposal_similar" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_22" name="Need adjustment" sourceRef="A1_proposal_resources" targetRef="A1_proposal_adapt" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_23" sourceRef="A1_proposal_adapt" targetRef="A1_proposal_feasible" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_24" name="Yes" sourceRef="A1_proposal_feasible" targetRef="A1_proposal_similar" />
      <bpmn:sequenceFlow id="A1_proposal_Flow_25" name="No" sourceRef="A1_proposal_feasible" targetRef="A1_proposal_preject" />
    </bpmn:subProcess>
    <bpmn:subProcess id="A1_review" name="Review proposal">
      <bpmn:incoming>A1_Student_Project_Flow_2</bpmn:incoming>
      <bpmn:outgoing>A1_Student_Project_Flow_3</bpmn:outgoing>
      <bpmn:startEvent id="A1_review_r0" name="Start">
        <bpmn:outgoing>A1_review_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="A1_review_evaluate" name="Committee evaluates proposal">
        <bpmn:incoming>A1_review_Flow_1</bpmn:incoming>
        <bpmn:incoming>A1_review_Flow_7</bpmn:incoming>
        <bpmn:outgoing>A1_review_Flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A1_review_decision" name="Committee decision">
        <bpmn:incoming>A1_review_Flow_2</bpmn:incoming>
        <bpmn:outgoing>A1_review_Flow_3</bpmn:outgoing>
        <bpmn:outgoing>A1_review_Flow_4</bpmn:outgoing>
        <bpmn:outgoing>A1_review_Flow_5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A1_review_rdone" name="Approved">
        <bpmn:incoming>A1_review_Flow_3</bpmn:incoming>
        <bpmn:incoming>A1_review_Flow_10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="A1_review_revlimit" name="Fewer than 2 revisions?">
        <bpmn:incoming>A1_review_Flow_4</bpmn:incoming>
        <bpmn:outgoing>A1_review_Flow_6</bpmn:outgoing>
        <bpmn:outgoing>A1_review_Flow_8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A1_review_revise" name="Student revises with coordinator">
        <bpmn:documentation>Record the completed revision cycle. A maximum of two revision cycles is allowed.</bpmn:documentation>
        <bpmn:incoming>A1_review_Flow_6</bpmn:incoming>
        <bpmn:outgoing>A1_review_Flow_7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="A1_review_finalreview" name="Committee makes final decision">
        <bpmn:incoming>A1_review_Flow_8</bpmn:incoming>
        <bpmn:outgoing>A1_review_Flow_9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A1_review_fg" name="Final approval?">
        <bpmn:incoming>A1_review_Flow_9</bpmn:incoming>
        <bpmn:outgoing>A1_review_Flow_10</bpmn:outgoing>
        <bpmn:outgoing>A1_review_Flow_11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="A1_review_reasons" name="Send rejection or expiry reasons">
        <bpmn:incoming>A1_review_Flow_5</bpmn:incoming>
        <bpmn:incoming>A1_review_Flow_11</bpmn:incoming>
        <bpmn:incoming>A1_review_Flow_12</bpmn:incoming>
        <bpmn:outgoing>A1_review_Flow_13</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="A1_review_rclosed" name="Review closed">
        <bpmn:incoming>A1_review_Flow_13</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="A1_error_CLOSED" />
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="A1_review_revisiontime" name="7-day revision deadline" attachedToRef="A1_review_revise">
        <bpmn:outgoing>A1_review_Flow_12</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="A1_review_remind" name="Review pending for 2 days" cancelActivity="false" attachedToRef="A1_review_evaluate">
        <bpmn:outgoing>A1_review_Flow_14</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P2D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="A1_review_notice" name="Send committee reminder">
        <bpmn:incoming>A1_review_Flow_14</bpmn:incoming>
        <bpmn:outgoing>A1_review_Flow_15</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="A1_review_remend" name="Reminder sent">
        <bpmn:incoming>A1_review_Flow_15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="A1_review_hodtimer" name="Review pending for 4 days" cancelActivity="false" attachedToRef="A1_review_evaluate">
        <bpmn:outgoing>A1_review_Flow_16</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P4D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="A1_review_hodnotice" name="Escalate delayed review to HoD">
        <bpmn:incoming>A1_review_Flow_16</bpmn:incoming>
        <bpmn:outgoing>A1_review_Flow_17</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="A1_review_hodend" name="HoD informed">
        <bpmn:incoming>A1_review_Flow_17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="A1_review_Flow_1" sourceRef="A1_review_r0" targetRef="A1_review_evaluate" />
      <bpmn:sequenceFlow id="A1_review_Flow_2" sourceRef="A1_review_evaluate" targetRef="A1_review_decision" />
      <bpmn:sequenceFlow id="A1_review_Flow_3" name="Approve" sourceRef="A1_review_decision" targetRef="A1_review_rdone" />
      <bpmn:sequenceFlow id="A1_review_Flow_4" name="Revise" sourceRef="A1_review_decision" targetRef="A1_review_revlimit" />
      <bpmn:sequenceFlow id="A1_review_Flow_5" name="Reject" sourceRef="A1_review_decision" targetRef="A1_review_reasons" />
      <bpmn:sequenceFlow id="A1_review_Flow_6" name="Yes" sourceRef="A1_review_revlimit" targetRef="A1_review_revise" />
      <bpmn:sequenceFlow id="A1_review_Flow_7" sourceRef="A1_review_revise" targetRef="A1_review_evaluate" />
      <bpmn:sequenceFlow id="A1_review_Flow_8" name="No" sourceRef="A1_review_revlimit" targetRef="A1_review_finalreview" />
      <bpmn:sequenceFlow id="A1_review_Flow_9" sourceRef="A1_review_finalreview" targetRef="A1_review_fg" />
      <bpmn:sequenceFlow id="A1_review_Flow_10" name="Yes" sourceRef="A1_review_fg" targetRef="A1_review_rdone" />
      <bpmn:sequenceFlow id="A1_review_Flow_11" name="No" sourceRef="A1_review_fg" targetRef="A1_review_reasons" />
      <bpmn:sequenceFlow id="A1_review_Flow_12" sourceRef="A1_review_revisiontime" targetRef="A1_review_reasons" />
      <bpmn:sequenceFlow id="A1_review_Flow_13" sourceRef="A1_review_reasons" targetRef="A1_review_rclosed" />
      <bpmn:sequenceFlow id="A1_review_Flow_14" sourceRef="A1_review_remind" targetRef="A1_review_notice" />
      <bpmn:sequenceFlow id="A1_review_Flow_15" sourceRef="A1_review_notice" targetRef="A1_review_remend" />
      <bpmn:sequenceFlow id="A1_review_Flow_16" sourceRef="A1_review_hodtimer" targetRef="A1_review_hodnotice" />
      <bpmn:sequenceFlow id="A1_review_Flow_17" sourceRef="A1_review_hodnotice" targetRef="A1_review_hodend" />
    </bpmn:subProcess>
    <bpmn:subProcess id="A1_allocation" name="Allocate guide">
      <bpmn:incoming>A1_Student_Project_Flow_3</bpmn:incoming>
      <bpmn:incoming>A1_Student_Project_Flow_8</bpmn:incoming>
      <bpmn:outgoing>A1_Student_Project_Flow_4</bpmn:outgoing>
      <bpmn:startEvent id="A1_allocation_a0" name="Start">
        <bpmn:outgoing>A1_allocation_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="A1_allocation_rule" name="Match guide domain and workload">
        <bpmn:incoming>A1_allocation_Flow_1</bpmn:incoming>
        <bpmn:incoming>A1_allocation_Flow_21</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_2</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="A1_allocation_available" name="Guide available?">
        <bpmn:incoming>A1_allocation_Flow_2</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_3</bpmn:outgoing>
        <bpmn:outgoing>A1_allocation_Flow_4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A1_allocation_reserve" name="Reserve guide slot">
        <bpmn:incoming>A1_allocation_Flow_3</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="A1_allocation_request" name="Send guide request">
        <bpmn:incoming>A1_allocation_Flow_5</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_6</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="A1_allocation_accept" name="Guide responds to request">
        <bpmn:incoming>A1_allocation_Flow_6</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A1_allocation_ag" name="Guide accepts?">
        <bpmn:incoming>A1_allocation_Flow_7</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_8</bpmn:outgoing>
        <bpmn:outgoing>A1_allocation_Flow_14</bpmn:outgoing>
        <bpmn:outgoing>A1_allocation_Flow_18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A1_allocation_record" name="Record accepted allocation">
        <bpmn:documentation>Store the confirmed guide assignment. A recording error is handled manually.</bpmn:documentation>
        <bpmn:incoming>A1_allocation_Flow_8</bpmn:incoming>
        <bpmn:incoming>A1_allocation_Flow_9</bpmn:incoming>
        <bpmn:incoming>A1_allocation_Flow_16</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="A1_allocation_notify" name="Notify student and guide">
        <bpmn:incoming>A1_allocation_Flow_10</bpmn:incoming>
        <bpmn:incoming>A1_allocation_Flow_13</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_11</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="A1_allocation_adone" name="Allocation confirmed">
        <bpmn:incoming>A1_allocation_Flow_11</bpmn:incoming>
        <bpmn:incoming>A1_allocation_Flow_24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="A1_allocation_manual" name="Coordinator confirms willing replacement guide">
        <bpmn:documentation>Coordinator checks willingness and capacity, releases any earlier reservation and confirms the replacement guide before completing this task.</bpmn:documentation>
        <bpmn:incoming>A1_allocation_Flow_4</bpmn:incoming>
        <bpmn:incoming>A1_allocation_Flow_22</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A1_allocation_silent" name="No reply in 3 days" attachedToRef="A1_allocation_accept">
        <bpmn:outgoing>A1_allocation_Flow_19</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P3D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="A1_allocation_systemfail" name="Recording failed" attachedToRef="A1_allocation_record">
        <bpmn:outgoing>A1_allocation_Flow_12</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="A1_error_SYSTEM" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A1_allocation_repair" name="Coordinator records allocation manually">
        <bpmn:incoming>A1_allocation_Flow_12</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="A1_allocation_terms" name="Discuss guide conditions with team">
        <bpmn:incoming>A1_allocation_Flow_14</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A1_allocation_termsok" name="Conditions agreed?">
        <bpmn:incoming>A1_allocation_Flow_15</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_16</bpmn:outgoing>
        <bpmn:outgoing>A1_allocation_Flow_17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:boundaryEvent id="A1_allocation_notifyfail" name="Notification failed" attachedToRef="A1_allocation_notify">
        <bpmn:outgoing>A1_allocation_Flow_23</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="A1_error_SYSTEM" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A1_allocation_manualnotify" name="Coordinator confirms notification manually">
        <bpmn:incoming>A1_allocation_Flow_23</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="A1_allocation_retry" name="Release guide; count and exclude refusal">
        <bpmn:incoming>A1_allocation_Flow_17</bpmn:incoming>
        <bpmn:incoming>A1_allocation_Flow_18</bpmn:incoming>
        <bpmn:incoming>A1_allocation_Flow_19</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A1_allocation_limit" name="Fewer than 3 requests?">
        <bpmn:incoming>A1_allocation_Flow_20</bpmn:incoming>
        <bpmn:outgoing>A1_allocation_Flow_21</bpmn:outgoing>
        <bpmn:outgoing>A1_allocation_Flow_22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="A1_allocation_Flow_1" sourceRef="A1_allocation_a0" targetRef="A1_allocation_rule" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_2" sourceRef="A1_allocation_rule" targetRef="A1_allocation_available" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_3" name="Yes" sourceRef="A1_allocation_available" targetRef="A1_allocation_reserve" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_4" name="No" sourceRef="A1_allocation_available" targetRef="A1_allocation_manual" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_5" sourceRef="A1_allocation_reserve" targetRef="A1_allocation_request" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_6" sourceRef="A1_allocation_request" targetRef="A1_allocation_accept" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_7" sourceRef="A1_allocation_accept" targetRef="A1_allocation_ag" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_8" name="Yes" sourceRef="A1_allocation_ag" targetRef="A1_allocation_record" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_9" sourceRef="A1_allocation_manual" targetRef="A1_allocation_record" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_10" sourceRef="A1_allocation_record" targetRef="A1_allocation_notify" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_11" sourceRef="A1_allocation_notify" targetRef="A1_allocation_adone" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_12" sourceRef="A1_allocation_systemfail" targetRef="A1_allocation_repair" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_13" sourceRef="A1_allocation_repair" targetRef="A1_allocation_notify" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_14" name="Conditional" sourceRef="A1_allocation_ag" targetRef="A1_allocation_terms" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_15" sourceRef="A1_allocation_terms" targetRef="A1_allocation_termsok" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_16" name="Yes" sourceRef="A1_allocation_termsok" targetRef="A1_allocation_record" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_17" name="No" sourceRef="A1_allocation_termsok" targetRef="A1_allocation_retry" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_18" name="No" sourceRef="A1_allocation_ag" targetRef="A1_allocation_retry" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_19" sourceRef="A1_allocation_silent" targetRef="A1_allocation_retry" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_20" sourceRef="A1_allocation_retry" targetRef="A1_allocation_limit" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_21" name="Yes" sourceRef="A1_allocation_limit" targetRef="A1_allocation_rule" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_22" name="No" sourceRef="A1_allocation_limit" targetRef="A1_allocation_manual" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_23" sourceRef="A1_allocation_notifyfail" targetRef="A1_allocation_manualnotify" />
      <bpmn:sequenceFlow id="A1_allocation_Flow_24" sourceRef="A1_allocation_manualnotify" targetRef="A1_allocation_adone" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="A1_Student_Project_withdraw" name="Team or guide withdraws" attachedToRef="A1_allocation">
      <bpmn:outgoing>A1_Student_Project_Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="A1_message_Withdrawal" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A1_Student_Project_rc" name="Not approved" attachedToRef="A1_review">
