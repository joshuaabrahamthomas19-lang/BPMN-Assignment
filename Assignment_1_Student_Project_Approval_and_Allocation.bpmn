      <bpmn:errorEventDefinition errorRef="A1_error_CLOSED" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A1_Student_Project_pc" name="Proposal closed" attachedToRef="A1_proposal">
