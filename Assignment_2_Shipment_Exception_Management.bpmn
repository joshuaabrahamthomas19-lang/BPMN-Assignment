      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_lost" bpmnElement="L_lost">
        <dc:Bounds x="3290.0" y="1625.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3230.0" y="1673.0" width="160" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_close" bpmnElement="L_close">
        <dc:Bounds x="2770.0" y="640.0" width="200" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_delivered" bpmnElement="L_delivered">
        <dc:Bounds x="3290.0" y="665.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3230.0" y="713.0" width="160" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_booking_stage" bpmnElement="L_booking_stage" isExpanded="false">
        <dc:Bounds x="1010.0" y="140.0" width="200" height="90" />
