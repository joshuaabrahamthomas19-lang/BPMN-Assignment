<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_logistics_shipment" targetNamespace="https://example.org/assignments">
  <bpmn:process id="logistics_shipment" name="Assignment 2 - Logistics and Shipment Exception Management" isExecutable="false">
    <bpmn:laneSet id="logistics_shipment_lanes">
      <bpmn:lane id="logistics_shipment_lane_0" name="Shipper / Customer">
        <bpmn:flowNodeRef>L_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_booking_stage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_booking_stage_catch_L_cancel_charge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics_shipment_lane_1" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>L_init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_cancel_charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_charge_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_shipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_cancel_message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_compensate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_return_catch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_lost_catch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_delivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics_shipment_lane_2" name="Pickup Agent">
        <bpmn:flowNodeRef>L_pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_pick_cancel_catch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics_shipment_lane_3" name="Claims Department">
        <bpmn:flowNodeRef>L_compensation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="L_start" name="Shipper books shipment">
      <bpmn:outgoing>Flow_L_start_L_init</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="L_init" name="Open Shipment Record">
      <bpmn:incoming>Flow_L_start_L_init</bpmn:incoming>
      <bpmn:outgoing>Flow_L_init_L_booking</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="L_pickup" name="Collect Parcel">
      <bpmn:incoming>Flow_L_booking_stage_L_pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_L_pickup_L_charge</bpmn:outgoing>
      <bpmn:laneSet id="L_pickup_lanes">
        <bpmn:lane id="L_pickup_lane_0" name="Pickup Agent">
          <bpmn:flowNodeRef>L_pick_start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_collect</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_pick_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_pick_cancel</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_pick_end</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_pick_exception</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_pick_capture</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_packaging</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_packing_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_repack</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_recheck_packing</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_repacked_gate</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_pickup_lane_1" name="Control Tower / Dispatcher">
          <bpmn:flowNodeRef>L_pick_count</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_pick_limit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_reschedule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_pick_wait</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="L_pick_start" name="Pickup starts">
        <bpmn:outgoing>Flow_L_pick_start_L_collect</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="L_collect" name="Collect parcel and capture pickup scan">
        <bpmn:incoming>Flow_L_pick_start_L_collect</bpmn:incoming>
        <bpmn:incoming>Flow_L_pick_wait_L_collect</bpmn:incoming>
        <bpmn:outgoing>Flow_L_collect_L_pick_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="L_pick_gate" name="Pickup result" default="Flow_L_pick_gate_L_pick_count">
        <bpmn:incoming>Flow_L_pick_capture_L_pick_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_L_pick_gate_L_pick_end</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_pick_gate_L_pick_count</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="L_pick_count" name="Count failed pickup">
        <bpmn:incoming>Flow_L_pick_gate_L_pick_count</bpmn:incoming>
        <bpmn:incoming>Flow_L_pick_exception_L_pick_count</bpmn:incoming>
        <bpmn:outgoing>Flow_L_pick_count_L_pick_limit</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="L_pick_limit" name="Two failures reached?" default="Flow_L_pick_limit_L_reschedule">
        <bpmn:incoming>Flow_L_pick_count_L_pick_limit</bpmn:incoming>
        <bpmn:outgoing>Flow_L_pick_limit_L_pick_cancel</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_pick_limit_L_reschedule</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="L_reschedule" name="Reschedule pickup">
        <bpmn:incoming>Flow_L_pick_limit_L_reschedule</bpmn:incoming>
        <bpmn:outgoing>Flow_L_reschedule_L_pick_wait</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="L_pick_wait" name="Wait before new pickup">
        <bpmn:incoming>Flow_L_reschedule_L_pick_wait</bpmn:incoming>
        <bpmn:outgoing>Flow_L_pick_wait_L_collect</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P1D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="L_pick_cancel" name="Pickup attempts exhausted">
        <bpmn:incoming>Flow_L_pick_limit_L_pick_cancel</bpmn:incoming>
        <bpmn:incoming>Flow_L_repacked_gate_L_pick_cancel</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="logistics_shipment_err_CANCEL_BOOKING" />
      </bpmn:endEvent>
      <bpmn:endEvent id="L_pick_end" name="Parcel collected">
        <bpmn:incoming>Flow_L_packing_gate_L_pick_end</bpmn:incoming>
        <bpmn:incoming>Flow_L_repacked_gate_L_pick_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_L_pick_start_L_collect" sourceRef="L_pick_start" targetRef="L_collect" />
      <bpmn:sequenceFlow id="Flow_L_collect_L_pick_gate" sourceRef="L_collect" targetRef="L_pick_capture" />
      <bpmn:sequenceFlow id="Flow_L_pick_gate_L_pick_end" sourceRef="L_pick_gate" targetRef="L_packaging" name="Collected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pickupOutcome = "collected"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_pick_gate_L_pick_count" sourceRef="L_pick_gate" targetRef="L_pick_count" name="Failed" />
      <bpmn:sequenceFlow id="Flow_L_pick_count_L_pick_limit" sourceRef="L_pick_count" targetRef="L_pick_limit" />
      <bpmn:sequenceFlow id="Flow_L_pick_limit_L_pick_cancel" sourceRef="L_pick_limit" targetRef="L_pick_cancel" name="Two failures">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pickupFailures &gt;= 2</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_pick_limit_L_reschedule" sourceRef="L_pick_limit" targetRef="L_reschedule" name="Reschedule" />
      <bpmn:sequenceFlow id="Flow_L_reschedule_L_pick_wait" sourceRef="L_reschedule" targetRef="L_pick_wait" />
      <bpmn:sequenceFlow id="Flow_L_pick_wait_L_collect" sourceRef="L_pick_wait" targetRef="L_collect" />
      <bpmn:boundaryEvent id="L_pick_exception" name="Pickup execution failure" attachedToRef="L_pick_capture" cancelActivity="true">
        <bpmn:outgoing>Flow_L_pick_exception_L_pick_count</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="logistics_shipment_err_PICKUP_FAILURE" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_L_pick_exception_L_pick_count" sourceRef="L_pick_exception" targetRef="L_pick_count" />
      <bpmn:serviceTask id="L_pick_capture" name="Persist pickup scan and report execution error">
        <bpmn:incoming>Flow_L_collect_L_pick_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_L_pick_capture_L_pick_gate</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_L_pick_capture_L_pick_gate" sourceRef="L_pick_capture" targetRef="L_pick_gate" />
      <bpmn:userTask id="L_packaging" name="Check Parcel Packaging">
        <bpmn:incoming>Flow_L_pick_gate_L_pick_end</bpmn:incoming>
        <bpmn:outgoing>Flow_L_packaging_L_pick_end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_L_packaging_L_pick_end" sourceRef="L_packaging" targetRef="L_packing_gate" />
      <bpmn:exclusiveGateway id="L_packing_gate" name="Packaging Safe for Transport?" default="Flow_L_packing_gate_L_repack">
        <bpmn:incoming>Flow_L_packaging_L_pick_end</bpmn:incoming>
        <bpmn:outgoing>Flow_L_packing_gate_L_pick_end</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_packing_gate_L_repack</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="L_repack" name="Ask Shipper to Repack Parcel">
        <bpmn:incoming>Flow_L_packing_gate_L_repack</bpmn:incoming>
        <bpmn:outgoing>Flow_L_repack_L_recheck_packing</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="L_recheck_packing" name="Check Repacked Parcel">
        <bpmn:incoming>Flow_L_repack_L_recheck_packing</bpmn:incoming>
        <bpmn:outgoing>Flow_L_recheck_packing_L_repacked_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="L_repacked_gate" name="Packing Issue Resolved?" default="Flow_L_repacked_gate_L_pick_cancel">
        <bpmn:incoming>Flow_L_recheck_packing_L_repacked_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_L_repacked_gate_L_pick_end</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_repacked_gate_L_pick_cancel</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_L_packing_gate_L_pick_end" sourceRef="L_packing_gate" targetRef="L_pick_end" name="Safe">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= packagingSafe = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_packing_gate_L_repack" sourceRef="L_packing_gate" targetRef="L_repack" name="Needs correction" />
      <bpmn:sequenceFlow id="Flow_L_repack_L_recheck_packing" sourceRef="L_repack" targetRef="L_recheck_packing" />
      <bpmn:sequenceFlow id="Flow_L_recheck_packing_L_repacked_gate" sourceRef="L_recheck_packing" targetRef="L_repacked_gate" />
      <bpmn:sequenceFlow id="Flow_L_repacked_gate_L_pick_end" sourceRef="L_repacked_gate" targetRef="L_pick_end" name="Safe after repacking">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= repackingAccepted = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_repacked_gate_L_pick_cancel" sourceRef="L_repacked_gate" targetRef="L_pick_cancel" name="Unsafe or refused" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="L_pick_cancel_catch" name="Cancel pickup booking" attachedToRef="L_pickup" cancelActivity="true">
      <bpmn:outgoing>Flow_L_pick_cancel_catch_L_cancel_charge</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="logistics_shipment_err_CANCEL_BOOKING" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="L_cancel_charge" name="Charge cancellation fee and notify">
      <bpmn:incoming>Flow_L_pick_cancel_catch_L_cancel_charge</bpmn:incoming>
      <bpmn:incoming>Flow_L_booking_stage_catch_L_cancel_charge_L_cancel_charge</bpmn:incoming>
      <bpmn:outgoing>Flow_L_cancel_charge_L_cancelled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="L_cancelled" name="Shipment cancelled">
      <bpmn:incoming>Flow_L_cancel_charge_L_cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L_pick_cancel_catch_L_cancel_charge" sourceRef="L_pick_cancel_catch" targetRef="L_cancel_charge" />
    <bpmn:sequenceFlow id="Flow_L_cancel_charge_L_cancelled" sourceRef="L_cancel_charge" targetRef="L_cancelled" />
    <bpmn:serviceTask id="L_charge" name="Record Shipment Charges">
      <bpmn:incoming>Flow_L_pickup_L_charge</bpmn:incoming>
      <bpmn:outgoing>Flow_L_charge_L_shipment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="L_charge_comp" name="Compensation" attachedToRef="L_charge" cancelActivity="false">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="L_refund" name="Refund charge minus cancellation fee idempotently" isForCompensation="true">
      </bpmn:serviceTask>
    <bpmn:subProcess id="L_shipment" name="Move Parcel and Deliver">
      <bpmn:incoming>Flow_L_charge_L_shipment</bpmn:incoming>
      <bpmn:outgoing>Flow_L_shipment_L_close</bpmn:outgoing>
      <bpmn:laneSet id="L_shipment_lanes">
        <bpmn:lane id="L_shipment_lane_0" name="Control Tower / Dispatcher">
          <bpmn:flowNodeRef>L_ship_start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_parallel</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_track_fail</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_track_reconcile</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_join</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_out</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_delivery_count</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_delivery_limit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_delivery_wait</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_depot_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_ship_return</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_surcharge_rule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_surcharge_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_surcharge_accept</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_address_limit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_address_count</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_ship_end</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_tracking_merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_dispatch_merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_delivery_instructions</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_check_proof</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_proof_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_recover_proof</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_shipment_lane_1" name="Shipper / Customer">
          <bpmn:flowNodeRef>L_notify_shipper</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_track_error</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_surcharge</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_shipment_lane_2" name="Hub / Warehouse">
          <bpmn:flowNodeRef>L_legs</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_shipment_lane_3" name="Recipient">
          <bpmn:flowNodeRef>L_recipient_notice</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_hold_notice</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_hold</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_hold_timeout</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_address_request</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_address</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_address_timeout</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_shipment_lane_4" name="Delivery Agent">
          <bpmn:flowNodeRef>L_deliver</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_delivery_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_depot_pod</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_shipment_lane_5" name="Claims Department">
          <bpmn:flowNodeRef>L_delivery_damage</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_delivery_claim_gate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_delivery_replace</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_delivery_refund</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_reship_gate</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="L_ship_start" name="Dispatch begins">
        <bpmn:outgoing>Flow_L_ship_start_L_parallel</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="L_parallel" name="Move and track together">
        <bpmn:incoming>Flow_L_dispatch_merge_L_parallel</bpmn:incoming>
        <bpmn:outgoing>Flow_L_parallel_L_legs</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_parallel_L_notify_shipper</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sendTask id="L_notify_shipper" name="Update tracking and notify shipper">
        <bpmn:incoming>Flow_L_parallel_L_notify_shipper</bpmn:incoming>
        <bpmn:outgoing>Flow_L_notify_shipper_L_join</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="L_track_fail" name="Manual tracking update">
        <bpmn:incoming>Flow_L_track_error_L_track_fail</bpmn:incoming>
        <bpmn:outgoing>Flow_L_track_fail_L_track_reconcile</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="L_track_reconcile" name="Reconcile tracking record">
        <bpmn:incoming>Flow_L_track_fail_L_track_reconcile</bpmn:incoming>
        <bpmn:outgoing>Flow_L_track_reconcile_L_join</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="L_track_error" name="Tracking system failed" attachedToRef="L_notify_shipper" cancelActivity="true">
        <bpmn:outgoing>Flow_L_track_error_L_track_fail</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="logistics_shipment_err_SCAN_FAILURE" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_L_track_error_L_track_fail" sourceRef="L_track_error" targetRef="L_track_fail" />
      <bpmn:sequenceFlow id="Flow_L_track_fail_L_track_reconcile" sourceRef="L_track_fail" targetRef="L_track_reconcile" />
      <bpmn:subProcess id="L_legs" name="Hub sorting scans and line haul per leg">
        <bpmn:incoming>Flow_L_parallel_L_legs</bpmn:incoming>
        <bpmn:outgoing>Flow_L_legs_L_join</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:loopCardinality>numberOfShipmentLegs</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
        <bpmn:laneSet id="L_legs_lanes">
          <bpmn:lane id="L_legs_lane_0" name="Hub / Warehouse">
            <bpmn:flowNodeRef>L_leg_start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_sort</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_scan</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_scan_error</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_manual_scan</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_reconcile</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_damage_gate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_customs_gate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_customs_check</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_customs_result</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_doc_review</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_doc_gate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_leg_return</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_leg_end</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_movement</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="L_legs_lane_1" name="Shipper / Customer">
            <bpmn:flowNodeRef>L_doc_request</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_documents</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_doc_timeout</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="L_legs_lane_2" name="Control Tower / Dispatcher">
            <bpmn:flowNodeRef>L_doc_limit</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>L_doc_count</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="L_legs_lane_3" name="Claims Department">
            <bpmn:flowNodeRef>L_damage</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="L_leg_start" name="Leg begins">
          <bpmn:outgoing>Flow_L_leg_start_L_sort</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="L_sort" name="Sort parcel at hub">
          <bpmn:incoming>Flow_L_leg_start_L_sort</bpmn:incoming>
          <bpmn:outgoing>Flow_L_sort_L_scan</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:serviceTask id="L_scan" name="Scan parcel and persist hub scan">
          <bpmn:incoming>Flow_L_sort_L_scan</bpmn:incoming>
          <bpmn:outgoing>Flow_L_scan_L_damage_gate</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:boundaryEvent id="L_scan_error" name="Scan failure" attachedToRef="L_scan" cancelActivity="true">
          <bpmn:outgoing>Flow_L_scan_error_L_manual_scan</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="logistics_shipment_err_SCAN_FAILURE" />
        </bpmn:boundaryEvent>
        <bpmn:userTask id="L_manual_scan" name="Supervisor captures scan manually">
          <bpmn:incoming>Flow_L_scan_error_L_manual_scan</bpmn:incoming>
          <bpmn:outgoing>Flow_L_manual_scan_L_reconcile</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:serviceTask id="L_reconcile" name="Reconcile scan and tracking">
          <bpmn:incoming>Flow_L_manual_scan_L_reconcile</bpmn:incoming>
          <bpmn:outgoing>Flow_L_reconcile_L_damage_gate</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="L_damage_gate" name="Damage detected?" default="Flow_L_damage_gate_L_customs_gate">
          <bpmn:incoming>Flow_L_scan_L_damage_gate</bpmn:incoming>
          <bpmn:incoming>Flow_L_reconcile_L_damage_gate</bpmn:incoming>
          <bpmn:outgoing>Flow_L_damage_gate_L_damage</bpmn:outgoing>
          <bpmn:outgoing>Flow_L_damage_gate_L_customs_gate</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="L_customs_gate" name="International leg requires clearance?" default="Flow_L_customs_gate_L_move">
          <bpmn:incoming>Flow_L_damage_gate_L_customs_gate</bpmn:incoming>
          <bpmn:incoming>Flow_L_damage_L_customs_gate</bpmn:incoming>
          <bpmn:outgoing>Flow_L_customs_gate_L_customs_check</bpmn:outgoing>
          <bpmn:outgoing>Flow_L_customs_gate_L_move</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:userTask id="L_customs_check" name="Customs clearance decision">
          <bpmn:incoming>Flow_L_customs_gate_L_customs_check</bpmn:incoming>
          <bpmn:outgoing>Flow_L_customs_check_L_customs_result</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="L_customs_result" name="Customs outcome" default="Flow_L_customs_result_L_doc_request">
          <bpmn:incoming>Flow_L_customs_check_L_customs_result</bpmn:incoming>
          <bpmn:outgoing>Flow_L_customs_result_L_move</bpmn:outgoing>
          <bpmn:outgoing>Flow_L_customs_result_L_doc_request</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sendTask id="L_doc_request" name="Request corrected customs documents">
          <bpmn:incoming>Flow_L_customs_result_L_doc_request</bpmn:incoming>
          <bpmn:incoming>Flow_L_doc_count_L_doc_request</bpmn:incoming>
          <bpmn:outgoing>Flow_L_doc_request_L_documents</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:receiveTask id="L_documents" name="Wait for shipper customs documents" messageRef="logistics_shipment_msg_customs_documents">
          <bpmn:incoming>Flow_L_doc_request_L_documents</bpmn:incoming>
          <bpmn:outgoing>Flow_L_documents_L_doc_review</bpmn:outgoing>
        </bpmn:receiveTask>
        <bpmn:boundaryEvent id="L_doc_timeout" name="Five day documents deadline" attachedToRef="L_documents" cancelActivity="true">
          <bpmn:outgoing>Flow_L_doc_timeout_L_leg_return</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>P5D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:userTask id="L_doc_review" name="Validate customs documents">
          <bpmn:incoming>Flow_L_documents_L_doc_review</bpmn:incoming>
          <bpmn:outgoing>Flow_L_doc_review_L_doc_gate</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="L_doc_gate" name="Documents accepted?" default="Flow_L_doc_gate_L_doc_limit">
          <bpmn:incoming>Flow_L_doc_review_L_doc_gate</bpmn:incoming>
          <bpmn:outgoing>Flow_L_doc_gate_L_move</bpmn:outgoing>
          <bpmn:outgoing>Flow_L_doc_gate_L_doc_limit</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="L_doc_limit" name="Document correction below two?" default="Flow_L_doc_limit_L_leg_return">
          <bpmn:incoming>Flow_L_doc_gate_L_doc_limit</bpmn:incoming>
          <bpmn:outgoing>Flow_L_doc_limit_L_doc_count</bpmn:outgoing>
          <bpmn:outgoing>Flow_L_doc_limit_L_leg_return</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="L_doc_count" name="Count document correction">
          <bpmn:incoming>Flow_L_doc_limit_L_doc_count</bpmn:incoming>
          <bpmn:outgoing>Flow_L_doc_count_L_doc_request</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="L_leg_return" name="Return required">
          <bpmn:incoming>Flow_L_doc_limit_L_leg_return</bpmn:incoming>
          <bpmn:incoming>Flow_L_doc_timeout_L_leg_return</bpmn:incoming>
          <bpmn:errorEventDefinition errorRef="logistics_shipment_err_RETURN_REQUIRED" />
        </bpmn:endEvent>
        <bpmn:endEvent id="L_leg_end" name="Leg movement complete">
          <bpmn:incoming>Flow_L_movement_L_leg_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:subProcess id="L_damage" name="Inspect damage and handle claim">
          <bpmn:incoming>Flow_L_damage_gate_L_damage</bpmn:incoming>
          <bpmn:outgoing>Flow_L_damage_L_customs_gate</bpmn:outgoing>
          <bpmn:laneSet id="L_damage_lanes">
            <bpmn:lane id="L_damage_lane_0" name="Claims Department">
              <bpmn:flowNodeRef>L_damage_start</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_inspect</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_insured</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_claim</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_claim_gate</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_claim_refund</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_replace</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_damage_return</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_damage_end</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="L_damage_lane_1" name="Shipper / Customer">
              <bpmn:flowNodeRef>L_uninsured</bpmn:flowNodeRef>
            </bpmn:lane>
          </bpmn:laneSet>
          <bpmn:startEvent id="L_damage_start" name="Damage inspection begins">
            <bpmn:outgoing>Flow_L_damage_start_L_inspect</bpmn:outgoing>
          </bpmn:startEvent>
          <bpmn:userTask id="L_inspect" name="Inspect damage">
            <bpmn:incoming>Flow_L_damage_start_L_inspect</bpmn:incoming>
            <bpmn:outgoing>Flow_L_inspect_L_insured</bpmn:outgoing>
          </bpmn:userTask>
          <bpmn:exclusiveGateway id="L_insured" name="Insured?" default="Flow_L_insured_L_uninsured">
            <bpmn:incoming>Flow_L_inspect_L_insured</bpmn:incoming>
            <bpmn:outgoing>Flow_L_insured_L_claim</bpmn:outgoing>
            <bpmn:outgoing>Flow_L_insured_L_uninsured</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:userTask id="L_claim" name="Resolve insured claim">
            <bpmn:incoming>Flow_L_insured_L_claim</bpmn:incoming>
            <bpmn:outgoing>Flow_L_claim_L_claim_gate</bpmn:outgoing>
          </bpmn:userTask>
          <bpmn:exclusiveGateway id="L_claim_gate" name="Claim resolution" default="Flow_L_claim_gate_L_replace">
            <bpmn:incoming>Flow_L_claim_L_claim_gate</bpmn:incoming>
            <bpmn:outgoing>Flow_L_claim_gate_L_claim_refund</bpmn:outgoing>
            <bpmn:outgoing>Flow_L_claim_gate_L_replace</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:serviceTask id="L_claim_refund" name="Pay claim refund and inform shipper">
            <bpmn:incoming>Flow_L_claim_gate_L_claim_refund</bpmn:incoming>
            <bpmn:outgoing>Flow_L_claim_refund_L_damage_return</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:serviceTask id="L_replace" name="Replace or reship parcel">
            <bpmn:incoming>Flow_L_claim_gate_L_replace</bpmn:incoming>
            <bpmn:outgoing>Flow_L_replace_L_damage_end</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:sendTask id="L_uninsured" name="Record uninsured damage and inform shipper">
            <bpmn:incoming>Flow_L_insured_L_uninsured</bpmn:incoming>
            <bpmn:outgoing>Flow_L_uninsured_L_damage_return</bpmn:outgoing>
          </bpmn:sendTask>
          <bpmn:endEvent id="L_damage_return" name="Damaged parcel return">
            <bpmn:incoming>Flow_L_uninsured_L_damage_return</bpmn:incoming>
            <bpmn:incoming>Flow_L_claim_refund_L_damage_return</bpmn:incoming>
            <bpmn:errorEventDefinition errorRef="logistics_shipment_err_RETURN_REQUIRED" />
          </bpmn:endEvent>
          <bpmn:endEvent id="L_damage_end" name="Replacement or reshipment ready">
            <bpmn:incoming>Flow_L_replace_L_damage_end</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="Flow_L_damage_start_L_inspect" sourceRef="L_damage_start" targetRef="L_inspect" />
          <bpmn:sequenceFlow id="Flow_L_inspect_L_insured" sourceRef="L_inspect" targetRef="L_insured" />
          <bpmn:sequenceFlow id="Flow_L_insured_L_claim" sourceRef="L_insured" targetRef="L_claim" name="Insured">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= insured = true</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Flow_L_insured_L_uninsured" sourceRef="L_insured" targetRef="L_uninsured" name="Uninsured" />
          <bpmn:sequenceFlow id="Flow_L_uninsured_L_damage_return" sourceRef="L_uninsured" targetRef="L_damage_return" />
          <bpmn:sequenceFlow id="Flow_L_claim_L_claim_gate" sourceRef="L_claim" targetRef="L_claim_gate" />
          <bpmn:sequenceFlow id="Flow_L_claim_gate_L_claim_refund" sourceRef="L_claim_gate" targetRef="L_claim_refund" name="Refund">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= claimOutcome = "refund"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Flow_L_claim_gate_L_replace" sourceRef="L_claim_gate" targetRef="L_replace" name="Replace or reship" />
          <bpmn:sequenceFlow id="Flow_L_claim_refund_L_damage_return" sourceRef="L_claim_refund" targetRef="L_damage_return" />
          <bpmn:sequenceFlow id="Flow_L_replace_L_damage_end" sourceRef="L_replace" targetRef="L_damage_end" />
        </bpmn:subProcess>
        <bpmn:sequenceFlow id="Flow_L_leg_start_L_sort" sourceRef="L_leg_start" targetRef="L_sort" />
        <bpmn:sequenceFlow id="Flow_L_sort_L_scan" sourceRef="L_sort" targetRef="L_scan" />
        <bpmn:sequenceFlow id="Flow_L_scan_L_damage_gate" sourceRef="L_scan" targetRef="L_damage_gate" />
        <bpmn:sequenceFlow id="Flow_L_scan_error_L_manual_scan" sourceRef="L_scan_error" targetRef="L_manual_scan" />
        <bpmn:sequenceFlow id="Flow_L_manual_scan_L_reconcile" sourceRef="L_manual_scan" targetRef="L_reconcile" />
        <bpmn:sequenceFlow id="Flow_L_reconcile_L_damage_gate" sourceRef="L_reconcile" targetRef="L_damage_gate" />
        <bpmn:sequenceFlow id="Flow_L_damage_gate_L_damage" sourceRef="L_damage_gate" targetRef="L_damage" name="Damaged">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= parcelCondition = "damaged"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_L_damage_gate_L_customs_gate" sourceRef="L_damage_gate" targetRef="L_customs_gate" name="Intact" />
        <bpmn:sequenceFlow id="Flow_L_damage_L_customs_gate" sourceRef="L_damage" targetRef="L_customs_gate" />
        <bpmn:sequenceFlow id="Flow_L_customs_gate_L_customs_check" sourceRef="L_customs_gate" targetRef="L_customs_check" name="International">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= international = true</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_L_customs_gate_L_move" sourceRef="L_customs_gate" targetRef="L_movement" name="Domestic" />
        <bpmn:sequenceFlow id="Flow_L_customs_check_L_customs_result" sourceRef="L_customs_check" targetRef="L_customs_result" />
        <bpmn:sequenceFlow id="Flow_L_customs_result_L_move" sourceRef="L_customs_result" targetRef="L_movement" name="Clear">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= customsOutcome = "clear"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_L_customs_result_L_doc_request" sourceRef="L_customs_result" targetRef="L_doc_request" name="Hold" />
        <bpmn:sequenceFlow id="Flow_L_doc_request_L_documents" sourceRef="L_doc_request" targetRef="L_documents" />
        <bpmn:sequenceFlow id="Flow_L_documents_L_doc_review" sourceRef="L_documents" targetRef="L_doc_review" />
        <bpmn:sequenceFlow id="Flow_L_doc_review_L_doc_gate" sourceRef="L_doc_review" targetRef="L_doc_gate" />
        <bpmn:sequenceFlow id="Flow_L_doc_gate_L_move" sourceRef="L_doc_gate" targetRef="L_movement" name="Valid">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsValid = "yes"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_L_doc_gate_L_doc_limit" sourceRef="L_doc_gate" targetRef="L_doc_limit" name="Invalid" />
        <bpmn:sequenceFlow id="Flow_L_doc_limit_L_doc_count" sourceRef="L_doc_limit" targetRef="L_doc_count" name="Correct again">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentCorrections &lt; 2</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_L_doc_limit_L_leg_return" sourceRef="L_doc_limit" targetRef="L_leg_return" name="Exhausted" />
        <bpmn:sequenceFlow id="Flow_L_doc_count_L_doc_request" sourceRef="L_doc_count" targetRef="L_doc_request" />
        <bpmn:sequenceFlow id="Flow_L_doc_timeout_L_leg_return" sourceRef="L_doc_timeout" targetRef="L_leg_return" />
        <bpmn:subProcess id="L_movement" name="Movement with last-scan watchdog">
          <bpmn:incoming>Flow_L_customs_gate_L_move</bpmn:incoming>
          <bpmn:incoming>Flow_L_customs_result_L_move</bpmn:incoming>
          <bpmn:incoming>Flow_L_doc_gate_L_move</bpmn:incoming>
          <bpmn:outgoing>Flow_L_movement_L_leg_end</bpmn:outgoing>
          <bpmn:laneSet id="L_movement_lanes">
            <bpmn:lane id="L_movement_lane_0" name="Hub / Warehouse">
              <bpmn:flowNodeRef>L_move</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_arrival</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_arrival_wait</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_move_start</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_move_end</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="L_movement_lane_1" name="Control Tower / Dispatcher">
              <bpmn:flowNodeRef>L_event_gate</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_delay</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_eta</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_reroute</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>L_watchdog</bpmn:flowNodeRef>
            </bpmn:lane>
          </bpmn:laneSet>
          <bpmn:serviceTask id="L_move" name="Dispatch line haul movement">
            <bpmn:incoming>Flow_L_move_start_L_move</bpmn:incoming>
            <bpmn:outgoing>Flow_L_move_L_event_gate</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:eventBasedGateway id="L_event_gate" name="Wait for arrival delay or ETA timer">
            <bpmn:incoming>Flow_L_move_L_event_gate</bpmn:incoming>
            <bpmn:outgoing>Flow_L_event_gate_L_arrival</bpmn:outgoing>
            <bpmn:outgoing>Flow_L_event_gate_L_delay</bpmn:outgoing>
            <bpmn:outgoing>Flow_L_event_gate_L_eta</bpmn:outgoing>
          </bpmn:eventBasedGateway>
          <bpmn:intermediateCatchEvent id="L_arrival" name="Destination hub scan received">
            <bpmn:incoming>Flow_L_event_gate_L_arrival</bpmn:incoming>
            <bpmn:outgoing>Flow_L_arrival_L_leg_end</bpmn:outgoing>
            <bpmn:messageEventDefinition messageRef="logistics_shipment_msg_leg_arrived" />
          </bpmn:intermediateCatchEvent>
          <bpmn:intermediateCatchEvent id="L_delay" name="Transit delay message">
            <bpmn:incoming>Flow_L_event_gate_L_delay</bpmn:incoming>
            <bpmn:outgoing>Flow_L_delay_L_reroute</bpmn:outgoing>
            <bpmn:messageEventDefinition messageRef="logistics_shipment_msg_transit_delay" />
          </bpmn:intermediateCatchEvent>
          <bpmn:intermediateCatchEvent id="L_eta" name="ETA exceeded">
            <bpmn:incoming>Flow_L_event_gate_L_eta</bpmn:incoming>
            <bpmn:outgoing>Flow_L_eta_L_reroute</bpmn:outgoing>
            <bpmn:timerEventDefinition>
              <bpmn:timeDuration>P1D</bpmn:timeDuration>
            </bpmn:timerEventDefinition>
          </bpmn:intermediateCatchEvent>
          <bpmn:sendTask id="L_reroute" name="Notify delay reroute alternate vehicle update ETA">
            <bpmn:incoming>Flow_L_delay_L_reroute</bpmn:incoming>
            <bpmn:incoming>Flow_L_eta_L_reroute</bpmn:incoming>
            <bpmn:outgoing>Flow_L_reroute_L_arrival_wait</bpmn:outgoing>
          </bpmn:sendTask>
          <bpmn:receiveTask id="L_arrival_wait" name="Wait for next destination scan" messageRef="logistics_shipment_msg_leg_arrived">
            <bpmn:incoming>Flow_L_reroute_L_arrival_wait</bpmn:incoming>
            <bpmn:outgoing>Flow_L_arrival_wait_L_leg_end</bpmn:outgoing>
          </bpmn:receiveTask>
          <bpmn:subProcess id="L_watchdog" name="Missing scan watchdog" triggeredByEvent="true">
            <bpmn:laneSet id="L_watchdog_lanes">
              <bpmn:lane id="L_watchdog_lane_0" name="Control Tower / Dispatcher">
                <bpmn:flowNodeRef>L_missing_start</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>L_trace</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>L_trace_timeout</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>L_trace_gate</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>L_trace_found</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>L_lost_error</bpmn:flowNodeRef>
              </bpmn:lane>
            </bpmn:laneSet>
            <bpmn:startEvent id="L_missing_start" name="No arrival scan for 48 hours" isInterrupting="true">
              <bpmn:outgoing>Flow_L_missing_start_L_trace</bpmn:outgoing>
              <bpmn:timerEventDefinition>
                <bpmn:timeDuration>P2D</bpmn:timeDuration>
              </bpmn:timerEventDefinition>
            </bpmn:startEvent>
            <bpmn:userTask id="L_trace" name="Trace parcel and confirm destination">
              <bpmn:incoming>Flow_L_missing_start_L_trace</bpmn:incoming>
              <bpmn:outgoing>Flow_L_trace_L_trace_gate</bpmn:outgoing>
            </bpmn:userTask>
            <bpmn:boundaryEvent id="L_trace_timeout" name="Five day trace deadline" attachedToRef="L_trace" cancelActivity="true">
              <bpmn:outgoing>Flow_L_trace_timeout_L_lost_error</bpmn:outgoing>
              <bpmn:timerEventDefinition>
                <bpmn:timeDuration>P5D</bpmn:timeDuration>
              </bpmn:timerEventDefinition>
            </bpmn:boundaryEvent>
            <bpmn:exclusiveGateway id="L_trace_gate" name="Parcel found?" default="Flow_L_trace_gate_L_lost_error">
              <bpmn:incoming>Flow_L_trace_L_trace_gate</bpmn:incoming>
              <bpmn:outgoing>Flow_L_trace_gate_L_trace_found</bpmn:outgoing>
              <bpmn:outgoing>Flow_L_trace_gate_L_lost_error</bpmn:outgoing>
            </bpmn:exclusiveGateway>
            <bpmn:endEvent id="L_trace_found" name="Tracing completed leg at destination">
              <bpmn:incoming>Flow_L_trace_gate_L_trace_found</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:endEvent id="L_lost_error" name="Declare parcel lost">
              <bpmn:incoming>Flow_L_trace_gate_L_lost_error</bpmn:incoming>
              <bpmn:incoming>Flow_L_trace_timeout_L_lost_error</bpmn:incoming>
              <bpmn:errorEventDefinition errorRef="logistics_shipment_err_PARCEL_LOST" />
            </bpmn:endEvent>
            <bpmn:sequenceFlow id="Flow_L_missing_start_L_trace" sourceRef="L_missing_start" targetRef="L_trace" />
            <bpmn:sequenceFlow id="Flow_L_trace_L_trace_gate" sourceRef="L_trace" targetRef="L_trace_gate" />
            <bpmn:sequenceFlow id="Flow_L_trace_gate_L_trace_found" sourceRef="L_trace_gate" targetRef="L_trace_found" name="Found">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= traceOutcome = "found_at_destination"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Flow_L_trace_gate_L_lost_error" sourceRef="L_trace_gate" targetRef="L_lost_error" name="Lost" />
            <bpmn:sequenceFlow id="Flow_L_trace_timeout_L_lost_error" sourceRef="L_trace_timeout" targetRef="L_lost_error" />
          </bpmn:subProcess>
          <bpmn:startEvent id="L_move_start" name="Departure scan starts movement clock">
            <bpmn:outgoing>Flow_L_move_start_L_move</bpmn:outgoing>
          </bpmn:startEvent>
          <bpmn:endEvent id="L_move_end" name="Destination scan completes movement">
            <bpmn:incoming>Flow_L_arrival_L_leg_end</bpmn:incoming>
            <bpmn:incoming>Flow_L_arrival_wait_L_leg_end</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="Flow_L_move_L_event_gate" sourceRef="L_move" targetRef="L_event_gate" />
          <bpmn:sequenceFlow id="Flow_L_event_gate_L_arrival" sourceRef="L_event_gate" targetRef="L_arrival" />
          <bpmn:sequenceFlow id="Flow_L_event_gate_L_delay" sourceRef="L_event_gate" targetRef="L_delay" />
          <bpmn:sequenceFlow id="Flow_L_event_gate_L_eta" sourceRef="L_event_gate" targetRef="L_eta" />
          <bpmn:sequenceFlow id="Flow_L_arrival_L_leg_end" sourceRef="L_arrival" targetRef="L_move_end" />
          <bpmn:sequenceFlow id="Flow_L_delay_L_reroute" sourceRef="L_delay" targetRef="L_reroute" />
          <bpmn:sequenceFlow id="Flow_L_reroute_L_arrival_wait" sourceRef="L_reroute" targetRef="L_arrival_wait" />
          <bpmn:sequenceFlow id="Flow_L_arrival_wait_L_leg_end" sourceRef="L_arrival_wait" targetRef="L_move_end" />
          <bpmn:sequenceFlow id="Flow_L_eta_L_reroute" sourceRef="L_eta" targetRef="L_reroute" />
          <bpmn:sequenceFlow id="Flow_L_move_start_L_move" sourceRef="L_move_start" targetRef="L_move" />
        </bpmn:subProcess>
        <bpmn:sequenceFlow id="Flow_L_movement_L_leg_end" sourceRef="L_movement" targetRef="L_leg_end" />
      </bpmn:subProcess>
      <bpmn:parallelGateway id="L_join" name="Movement and notification joined">
        <bpmn:incoming>Flow_L_legs_L_join</bpmn:incoming>
        <bpmn:incoming>Flow_L_tracking_merge_L_join</bpmn:incoming>
        <bpmn:outgoing>Flow_L_join_L_out</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="L_out" name="Assign last mile delivery agent">
        <bpmn:incoming>Flow_L_join_L_out</bpmn:incoming>
        <bpmn:outgoing>Flow_L_out_L_recipient_notice</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="L_recipient_notice" name="Notify recipient out for delivery">
        <bpmn:incoming>Flow_L_delivery_instructions_L_recipient_notice</bpmn:incoming>
        <bpmn:outgoing>Flow_L_recipient_notice_L_deliver</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="L_deliver" name="Handover COD and capture proof of delivery">
        <bpmn:incoming>Flow_L_recipient_notice_L_deliver</bpmn:incoming>
        <bpmn:incoming>Flow_L_delivery_wait_L_deliver</bpmn:incoming>
        <bpmn:incoming>Flow_L_surcharge_gate_L_deliver</bpmn:incoming>
        <bpmn:incoming>Flow_L_surcharge_accept_L_deliver</bpmn:incoming>
        <bpmn:incoming>Flow_L_reship_gate_L_deliver</bpmn:incoming>
        <bpmn:outgoing>Flow_L_deliver_L_delivery_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="L_delivery_gate" name="Delivery outcome" default="Flow_L_delivery_gate_L_ship_return">
        <bpmn:incoming>Flow_L_deliver_L_delivery_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_L_delivery_gate_L_ship_end</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_delivery_gate_L_delivery_count</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_delivery_gate_L_address_limit</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_delivery_gate_L_delivery_damage</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_delivery_gate_L_ship_return</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="L_delivery_count" name="Count unavailable delivery">
        <bpmn:incoming>Flow_L_delivery_gate_L_delivery_count</bpmn:incoming>
        <bpmn:outgoing>Flow_L_delivery_count_L_delivery_limit</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="L_delivery_limit" name="Three attempts reached?" default="Flow_L_delivery_limit_L_delivery_wait">
        <bpmn:incoming>Flow_L_delivery_count_L_delivery_limit</bpmn:incoming>
        <bpmn:outgoing>Flow_L_delivery_limit_L_hold_notice</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_delivery_limit_L_delivery_wait</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="L_delivery_wait" name="Reattempt next day">
        <bpmn:incoming>Flow_L_delivery_limit_L_delivery_wait</bpmn:incoming>
        <bpmn:outgoing>Flow_L_delivery_wait_L_deliver</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P1D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="L_hold_notice" name="Offer Agreed Depot Pickup or Authorized Collection">
        <bpmn:incoming>Flow_L_delivery_limit_L_hold_notice</bpmn:incoming>
        <bpmn:outgoing>Flow_L_hold_notice_L_hold</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="L_hold" name="Wait for recipient depot collection" messageRef="logistics_shipment_msg_depot_collected">
        <bpmn:incoming>Flow_L_hold_notice_L_hold</bpmn:incoming>
        <bpmn:outgoing>Flow_L_hold_L_depot_pod</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="L_hold_timeout" name="Seven day hold expired" attachedToRef="L_hold" cancelActivity="true">
        <bpmn:outgoing>Flow_L_hold_timeout_L_ship_return</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="L_depot_pod" name="Verify Collector Identity and Capture Delivery Proof">
        <bpmn:incoming>Flow_L_hold_L_depot_pod</bpmn:incoming>
        <bpmn:outgoing>Flow_L_depot_pod_L_depot_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="L_depot_gate" name="Depot handover successful?" default="Flow_L_depot_gate_L_ship_return">
        <bpmn:incoming>Flow_L_depot_pod_L_depot_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_L_depot_gate_L_ship_end</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_depot_gate_L_ship_return</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="L_ship_return" name="Shipment return required">
        <bpmn:incoming>Flow_L_delivery_gate_L_ship_return</bpmn:incoming>
        <bpmn:incoming>Flow_L_depot_gate_L_ship_return</bpmn:incoming>
        <bpmn:incoming>Flow_L_hold_timeout_L_ship_return</bpmn:incoming>
        <bpmn:incoming>Flow_L_address_limit_L_ship_return</bpmn:incoming>
        <bpmn:incoming>Flow_L_surcharge_accept_L_ship_return</bpmn:incoming>
        <bpmn:incoming>Flow_L_address_timeout_L_ship_return</bpmn:incoming>
        <bpmn:incoming>Flow_L_delivery_refund_L_ship_return</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="logistics_shipment_err_RETURN_REQUIRED" />
      </bpmn:endEvent>
      <bpmn:sendTask id="L_address_request" name="Contact recipient for corrected address">
        <bpmn:incoming>Flow_L_address_count_L_address_request</bpmn:incoming>
        <bpmn:outgoing>Flow_L_address_request_L_address</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="L_address" name="Wait for address correction" messageRef="logistics_shipment_msg_address_corrected">
        <bpmn:incoming>Flow_L_address_request_L_address</bpmn:incoming>
        <bpmn:outgoing>Flow_L_address_L_surcharge_rule</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="L_address_timeout" name="Address correction deadline" attachedToRef="L_address" cancelActivity="true">
        <bpmn:outgoing>Flow_L_address_timeout_L_ship_return</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P2D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:businessRuleTask id="L_surcharge_rule" name="Determine zone surcharge">
        <bpmn:incoming>Flow_L_address_L_surcharge_rule</bpmn:incoming>
        <bpmn:outgoing>Flow_L_surcharge_rule_L_surcharge_gate</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="L_surcharge_gate" name="Surcharge needed?" default="Flow_L_surcharge_gate_L_deliver">
        <bpmn:incoming>Flow_L_surcharge_rule_L_surcharge_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_L_surcharge_gate_L_surcharge</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_surcharge_gate_L_deliver</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="L_surcharge" name="Confirm and record surcharge">
        <bpmn:incoming>Flow_L_surcharge_gate_L_surcharge</bpmn:incoming>
        <bpmn:outgoing>Flow_L_surcharge_L_surcharge_accept</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="L_surcharge_accept" name="Surcharge accepted?" default="Flow_L_surcharge_accept_L_ship_return">
        <bpmn:incoming>Flow_L_surcharge_L_surcharge_accept</bpmn:incoming>
        <bpmn:outgoing>Flow_L_surcharge_accept_L_deliver</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_surcharge_accept_L_ship_return</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="L_address_limit" name="Doorstep corrections below two?" default="Flow_L_address_limit_L_ship_return">
        <bpmn:incoming>Flow_L_delivery_gate_L_address_limit</bpmn:incoming>
        <bpmn:outgoing>Flow_L_address_limit_L_address_count</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_address_limit_L_ship_return</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="L_address_count" name="Count doorstep address correction">
        <bpmn:incoming>Flow_L_address_limit_L_address_count</bpmn:incoming>
        <bpmn:outgoing>Flow_L_address_count_L_address_request</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="L_delivery_damage" name="Inspect delivery damage and resolve claim">
        <bpmn:incoming>Flow_L_delivery_gate_L_delivery_damage</bpmn:incoming>
        <bpmn:outgoing>Flow_L_delivery_damage_L_delivery_claim_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="L_delivery_claim_gate" name="Delivery claim resolution" default="Flow_L_delivery_claim_gate_L_delivery_refund">
        <bpmn:incoming>Flow_L_delivery_damage_L_delivery_claim_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_L_delivery_claim_gate_L_delivery_replace</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_delivery_claim_gate_L_delivery_refund</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="L_delivery_replace" name="Execute insured replacement or reshipment">
        <bpmn:incoming>Flow_L_delivery_claim_gate_L_delivery_replace</bpmn:incoming>
        <bpmn:outgoing>Flow_L_delivery_replace_L_deliver</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="L_delivery_refund" name="Record damage refund or uninsured notice">
        <bpmn:incoming>Flow_L_delivery_claim_gate_L_delivery_refund</bpmn:incoming>
        <bpmn:outgoing>Flow_L_delivery_refund_L_ship_return</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="L_ship_end" name="Delivery and POD confirmed">
        <bpmn:incoming>Flow_L_proof_gate_L_ship_end</bpmn:incoming>
        <bpmn:incoming>Flow_L_recover_proof_L_ship_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_L_ship_start_L_parallel" sourceRef="L_ship_start" targetRef="L_dispatch_merge" />
      <bpmn:sequenceFlow id="Flow_L_parallel_L_legs" sourceRef="L_parallel" targetRef="L_legs" />
      <bpmn:sequenceFlow id="Flow_L_parallel_L_notify_shipper" sourceRef="L_parallel" targetRef="L_notify_shipper" />
      <bpmn:sequenceFlow id="Flow_L_legs_L_join" sourceRef="L_legs" targetRef="L_join" />
      <bpmn:sequenceFlow id="Flow_L_notify_shipper_L_join" sourceRef="L_notify_shipper" targetRef="L_tracking_merge" />
      <bpmn:sequenceFlow id="Flow_L_track_reconcile_L_join" sourceRef="L_track_reconcile" targetRef="L_tracking_merge" />
      <bpmn:sequenceFlow id="Flow_L_join_L_out" sourceRef="L_join" targetRef="L_out" />
      <bpmn:sequenceFlow id="Flow_L_out_L_recipient_notice" sourceRef="L_out" targetRef="L_delivery_instructions" />
      <bpmn:sequenceFlow id="Flow_L_recipient_notice_L_deliver" sourceRef="L_recipient_notice" targetRef="L_deliver" />
      <bpmn:sequenceFlow id="Flow_L_deliver_L_delivery_gate" sourceRef="L_deliver" targetRef="L_delivery_gate" />
      <bpmn:sequenceFlow id="Flow_L_delivery_gate_L_ship_end" sourceRef="L_delivery_gate" targetRef="L_check_proof" name="Delivered">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryOutcome = "delivered"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_delivery_gate_L_delivery_count" sourceRef="L_delivery_gate" targetRef="L_delivery_count" name="Unavailable">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryOutcome = "unavailable"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_delivery_gate_L_address_limit" sourceRef="L_delivery_gate" targetRef="L_address_limit" name="Wrong address">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryOutcome = "wrong_address"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_delivery_gate_L_delivery_damage" sourceRef="L_delivery_gate" targetRef="L_delivery_damage" name="Damaged">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryOutcome = "damaged"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_delivery_gate_L_ship_return" sourceRef="L_delivery_gate" targetRef="L_ship_return" name="Refusal or COD failure" />
      <bpmn:sequenceFlow id="Flow_L_delivery_count_L_delivery_limit" sourceRef="L_delivery_count" targetRef="L_delivery_limit" />
      <bpmn:sequenceFlow id="Flow_L_delivery_limit_L_hold_notice" sourceRef="L_delivery_limit" targetRef="L_hold_notice" name="Three attempts">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryAttempts &gt;= 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_delivery_limit_L_delivery_wait" sourceRef="L_delivery_limit" targetRef="L_delivery_wait" name="Retry" />
      <bpmn:sequenceFlow id="Flow_L_delivery_wait_L_deliver" sourceRef="L_delivery_wait" targetRef="L_deliver" />
      <bpmn:sequenceFlow id="Flow_L_hold_notice_L_hold" sourceRef="L_hold_notice" targetRef="L_hold" />
      <bpmn:sequenceFlow id="Flow_L_hold_L_depot_pod" sourceRef="L_hold" targetRef="L_depot_pod" />
      <bpmn:sequenceFlow id="Flow_L_depot_pod_L_depot_gate" sourceRef="L_depot_pod" targetRef="L_depot_gate" />
      <bpmn:sequenceFlow id="Flow_L_depot_gate_L_ship_end" sourceRef="L_depot_gate" targetRef="L_check_proof" name="Collected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= depotOutcome = "collected"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_depot_gate_L_ship_return" sourceRef="L_depot_gate" targetRef="L_ship_return" name="Refusal or COD failure" />
      <bpmn:sequenceFlow id="Flow_L_hold_timeout_L_ship_return" sourceRef="L_hold_timeout" targetRef="L_ship_return" />
      <bpmn:sequenceFlow id="Flow_L_address_limit_L_address_count" sourceRef="L_address_limit" targetRef="L_address_count" name="Correct">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= addressCorrections &lt; 2</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_address_limit_L_ship_return" sourceRef="L_address_limit" targetRef="L_ship_return" name="Exhausted" />
      <bpmn:sequenceFlow id="Flow_L_address_count_L_address_request" sourceRef="L_address_count" targetRef="L_address_request" />
      <bpmn:sequenceFlow id="Flow_L_address_request_L_address" sourceRef="L_address_request" targetRef="L_address" />
      <bpmn:sequenceFlow id="Flow_L_address_L_surcharge_rule" sourceRef="L_address" targetRef="L_surcharge_rule" />
      <bpmn:sequenceFlow id="Flow_L_surcharge_rule_L_surcharge_gate" sourceRef="L_surcharge_rule" targetRef="L_surcharge_gate" />
      <bpmn:sequenceFlow id="Flow_L_surcharge_gate_L_surcharge" sourceRef="L_surcharge_gate" targetRef="L_surcharge" name="New zone">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= surcharge &gt; 0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_surcharge_gate_L_deliver" sourceRef="L_surcharge_gate" targetRef="L_deliver" name="No surcharge" />
      <bpmn:sequenceFlow id="Flow_L_surcharge_L_surcharge_accept" sourceRef="L_surcharge" targetRef="L_surcharge_accept" />
      <bpmn:sequenceFlow id="Flow_L_surcharge_accept_L_deliver" sourceRef="L_surcharge_accept" targetRef="L_deliver" name="Accepted">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= surchargeAccepted = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_surcharge_accept_L_ship_return" sourceRef="L_surcharge_accept" targetRef="L_ship_return" name="Declined" />
      <bpmn:sequenceFlow id="Flow_L_address_timeout_L_ship_return" sourceRef="L_address_timeout" targetRef="L_ship_return" />
      <bpmn:sequenceFlow id="Flow_L_delivery_damage_L_delivery_claim_gate" sourceRef="L_delivery_damage" targetRef="L_delivery_claim_gate" />
      <bpmn:sequenceFlow id="Flow_L_delivery_claim_gate_L_delivery_replace" sourceRef="L_delivery_claim_gate" targetRef="L_delivery_replace" name="Insured replacement">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= insured = true and replacementCount &lt; 1 and (deliveryClaim = "replace" or deliveryClaim = "reship")</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_delivery_claim_gate_L_delivery_refund" sourceRef="L_delivery_claim_gate" targetRef="L_delivery_refund" name="Refund or uninsured" />
      <bpmn:sequenceFlow id="Flow_L_delivery_replace_L_deliver" sourceRef="L_delivery_replace" targetRef="L_reship_gate" />
      <bpmn:sequenceFlow id="Flow_L_delivery_refund_L_ship_return" sourceRef="L_delivery_refund" targetRef="L_ship_return" />
      <bpmn:exclusiveGateway id="L_reship_gate" name="Replace locally or reship?" default="Flow_L_reship_gate_L_deliver">
        <bpmn:incoming>Flow_L_delivery_replace_L_deliver</bpmn:incoming>
        <bpmn:outgoing>Flow_L_reship_gate_L_parallel</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_reship_gate_L_deliver</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_L_reship_gate_L_parallel" sourceRef="L_reship_gate" targetRef="L_dispatch_merge" name="Reship">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryClaim = "reship"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_reship_gate_L_deliver" sourceRef="L_reship_gate" targetRef="L_deliver" name="Local replacement" />
      <bpmn:exclusiveGateway id="L_tracking_merge" name="Tracking success or recovery merge">
        <bpmn:incoming>Flow_L_notify_shipper_L_join</bpmn:incoming>
        <bpmn:incoming>Flow_L_track_reconcile_L_join</bpmn:incoming>
        <bpmn:outgoing>Flow_L_tracking_merge_L_join</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="L_dispatch_merge" name="Initial dispatch or reshipment merge">
        <bpmn:incoming>Flow_L_ship_start_L_parallel</bpmn:incoming>
        <bpmn:incoming>Flow_L_reship_gate_L_parallel</bpmn:incoming>
        <bpmn:outgoing>Flow_L_dispatch_merge_L_parallel</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_L_tracking_merge_L_join" sourceRef="L_tracking_merge" targetRef="L_join" />
      <bpmn:sequenceFlow id="Flow_L_dispatch_merge_L_parallel" sourceRef="L_dispatch_merge" targetRef="L_parallel" />
      <bpmn:userTask id="L_delivery_instructions" name="Confirm Delivery Instructions">
        <bpmn:incoming>Flow_L_out_L_recipient_notice</bpmn:incoming>
        <bpmn:outgoing>Flow_L_delivery_instructions_L_recipient_notice</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_L_delivery_instructions_L_recipient_notice" sourceRef="L_delivery_instructions" targetRef="L_recipient_notice" />
      <bpmn:userTask id="L_check_proof" name="Check Delivery Evidence">
        <bpmn:incoming>Flow_L_delivery_gate_L_ship_end</bpmn:incoming>
        <bpmn:incoming>Flow_L_depot_gate_L_ship_end</bpmn:incoming>
        <bpmn:outgoing>Flow_L_check_proof_L_proof_gate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="L_proof_gate" name="Delivery Evidence Complete?" default="Flow_L_proof_gate_L_recover_proof">
        <bpmn:incoming>Flow_L_check_proof_L_proof_gate</bpmn:incoming>
        <bpmn:outgoing>Flow_L_proof_gate_L_ship_end</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_proof_gate_L_recover_proof</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="L_recover_proof" name="Recover Proof or Verify Receipt">
        <bpmn:documentation>Complete this task only after a signed proof is recovered or receipt is confirmed with the recipient and recorded. If confirmation is unavailable, keep the case open for investigation; do not complete the task or declare delivery merely because an attempt occurred.</bpmn:documentation>
        <bpmn:incoming>Flow_L_proof_gate_L_recover_proof</bpmn:incoming>
        <bpmn:outgoing>Flow_L_recover_proof_L_ship_end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_L_check_proof_L_proof_gate" sourceRef="L_check_proof" targetRef="L_proof_gate" />
      <bpmn:sequenceFlow id="Flow_L_proof_gate_L_ship_end" sourceRef="L_proof_gate" targetRef="L_ship_end" name="Complete">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryEvidenceComplete = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_proof_gate_L_recover_proof" sourceRef="L_proof_gate" targetRef="L_recover_proof" name="Missing or unclear" />
      <bpmn:sequenceFlow id="Flow_L_recover_proof_L_ship_end" sourceRef="L_recover_proof" targetRef="L_ship_end" name="Receipt verified" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="L_cancel_message" name="Cancel after dispatch" attachedToRef="L_shipment" cancelActivity="true">
      <bpmn:outgoing>Flow_L_cancel_message_L_stop</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="logistics_shipment_msg_cancel" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="L_stop" name="Stop movement and intercept parcel">
      <bpmn:incoming>Flow_L_cancel_message_L_stop</bpmn:incoming>
      <bpmn:outgoing>Flow_L_stop_L_compensate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="L_compensate" name="Compensate charge minus fee">
      <bpmn:incoming>Flow_L_stop_L_compensate</bpmn:incoming>
      <bpmn:outgoing>Flow_L_compensate_L_return</bpmn:outgoing>
      <bpmn:compensateEventDefinition activityRef="L_charge" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="L_return" name="Return parcel to sender adjust charges notify">
      <bpmn:incoming>Flow_L_compensate_L_return</bpmn:incoming>
      <bpmn:incoming>Flow_L_return_catch_L_return</bpmn:incoming>
      <bpmn:outgoing>Flow_L_return_L_returned</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="L_returned" name="Returned to sender">
      <bpmn:incoming>Flow_L_return_L_returned</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L_cancel_message_L_stop" sourceRef="L_cancel_message" targetRef="L_stop" />
    <bpmn:sequenceFlow id="Flow_L_stop_L_compensate" sourceRef="L_stop" targetRef="L_compensate" />
    <bpmn:sequenceFlow id="Flow_L_compensate_L_return" sourceRef="L_compensate" targetRef="L_return" />
    <bpmn:sequenceFlow id="Flow_L_return_L_returned" sourceRef="L_return" targetRef="L_returned" />
    <bpmn:boundaryEvent id="L_return_catch" name="Return outcome from transit or delivery" attachedToRef="L_shipment" cancelActivity="true">
      <bpmn:outgoing>Flow_L_return_catch_L_return</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="logistics_shipment_err_RETURN_REQUIRED" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_L_return_catch_L_return" sourceRef="L_return_catch" targetRef="L_return" />
    <bpmn:boundaryEvent id="L_lost_catch" name="Parcel lost after tracing" attachedToRef="L_shipment" cancelActivity="true">
      <bpmn:outgoing>Flow_L_lost_catch_L_compensation</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="logistics_shipment_err_PARCEL_LOST" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="L_compensation" name="Pay loss compensation and notify customer">
      <bpmn:incoming>Flow_L_lost_catch_L_compensation</bpmn:incoming>
      <bpmn:outgoing>Flow_L_compensation_L_lost</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="L_lost" name="Shipment closed as lost">
      <bpmn:incoming>Flow_L_compensation_L_lost</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L_lost_catch_L_compensation" sourceRef="L_lost_catch" targetRef="L_compensation" />
    <bpmn:sequenceFlow id="Flow_L_compensation_L_lost" sourceRef="L_compensation" targetRef="L_lost" />
    <bpmn:serviceTask id="L_close" name="Close Shipment and Invoice">
      <bpmn:incoming>Flow_L_shipment_L_close</bpmn:incoming>
      <bpmn:outgoing>Flow_L_close_L_delivered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="L_delivered" name="Shipment delivered and closed">
      <bpmn:incoming>Flow_L_close_L_delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L_shipment_L_close" sourceRef="L_shipment" targetRef="L_close" />
    <bpmn:sequenceFlow id="Flow_L_close_L_delivered" sourceRef="L_close" targetRef="L_delivered" />
    <bpmn:sequenceFlow id="Flow_L_start_L_init" sourceRef="L_start" targetRef="L_init" />
    <bpmn:sequenceFlow id="Flow_L_init_L_booking" sourceRef="L_init" targetRef="L_booking_stage" />
    <bpmn:sequenceFlow id="Flow_L_pickup_L_charge" sourceRef="L_pickup" targetRef="L_charge" />
    <bpmn:sequenceFlow id="Flow_L_charge_L_shipment" sourceRef="L_charge" targetRef="L_shipment" />
    <bpmn:subProcess id="L_booking_stage" name="Book and Check Shipment">
      <bpmn:incoming>Flow_L_init_L_booking</bpmn:incoming>
      <bpmn:outgoing>Flow_L_booking_stage_L_pickup</bpmn:outgoing>
      <bpmn:laneSet id="L_booking_stage_lanes">
        <bpmn:lane id="L_booking_stage_lane_0" name="Control Tower / Dispatcher">
          <bpmn:flowNodeRef>L_schedule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_correct_limit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_valid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_correction</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_rule</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_booking_stage_lane_1" name="Shipper / Customer">
          <bpmn:flowNodeRef>L_booking</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_booking_stage_exit_L_cancel_charge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_booking_stage_exit_L_pickup</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_booking_stage_start</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:serviceTask id="L_schedule" name="Schedule pickup and assign driver">
        <bpmn:incoming>Flow_L_valid_L_schedule</bpmn:incoming>
        <bpmn:outgoing>Flow_L_schedule_L_pickup</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="L_booking" name="Create or correct booking">
        <bpmn:incoming>Flow_L_correction_L_booking</bpmn:incoming>
        <bpmn:incoming>Flow_L_booking_stage_start_L_booking</bpmn:incoming>
        <bpmn:outgoing>Flow_L_booking_L_rule</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="L_correct_limit" name="Correction attempts below three?" default="Flow_L_correct_limit_L_cancel_charge">
        <bpmn:incoming>Flow_L_valid_L_correct_limit</bpmn:incoming>
        <bpmn:outgoing>Flow_L_correct_limit_L_correction</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_correct_limit_L_cancel_charge</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="L_valid" name="Valid booking?" default="Flow_L_valid_L_correct_limit">
        <bpmn:incoming>Flow_L_rule_L_valid</bpmn:incoming>
        <bpmn:outgoing>Flow_L_valid_L_schedule</bpmn:outgoing>
        <bpmn:outgoing>Flow_L_valid_L_correct_limit</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="L_correction" name="Request booking correction">
        <bpmn:incoming>Flow_L_correct_limit_L_correction</bpmn:incoming>
        <bpmn:outgoing>Flow_L_correction_L_booking</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:businessRuleTask id="L_rule" name="Validate address weight service and calculate charge">
        <bpmn:incoming>Flow_L_booking_L_rule</bpmn:incoming>
        <bpmn:outgoing>Flow_L_rule_L_valid</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:sequenceFlow id="Flow_L_booking_L_rule" sourceRef="L_booking" targetRef="L_rule" />
      <bpmn:sequenceFlow id="Flow_L_rule_L_valid" sourceRef="L_rule" targetRef="L_valid" />
      <bpmn:sequenceFlow id="Flow_L_valid_L_schedule" sourceRef="L_valid" targetRef="L_schedule" name="Valid">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= bookingValid = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_valid_L_correct_limit" sourceRef="L_valid" targetRef="L_correct_limit" name="Invalid" />
      <bpmn:sequenceFlow id="Flow_L_correct_limit_L_correction" sourceRef="L_correct_limit" targetRef="L_correction" name="Correct">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= bookingAttempts &lt; 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_L_correct_limit_L_cancel_charge" sourceRef="L_correct_limit" targetRef="L_booking_stage_exit_L_cancel_charge" name="Exhausted" />
      <bpmn:endEvent id="L_booking_stage_exit_L_cancel_charge" name="Charge cancellation fee and notify">
        <bpmn:incoming>Flow_L_correct_limit_L_cancel_charge</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="logistics_shipment_err_EXIT_L_cancel_charge" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_L_correction_L_booking" sourceRef="L_correction" targetRef="L_booking" />
      <bpmn:sequenceFlow id="Flow_L_schedule_L_pickup" sourceRef="L_schedule" targetRef="L_booking_stage_exit_L_pickup" />
      <bpmn:endEvent id="L_booking_stage_exit_L_pickup" name="Approved">
        <bpmn:incoming>Flow_L_schedule_L_pickup</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:startEvent id="L_booking_stage_start" name="Start">
        <bpmn:outgoing>Flow_L_booking_stage_start_L_booking</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_L_booking_stage_start_L_booking" sourceRef="L_booking_stage_start" targetRef="L_booking" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="L_booking_stage_catch_L_cancel_charge" name="Charge cancellation fee and notify" attachedToRef="L_booking_stage" cancelActivity="true">
      <bpmn:outgoing>Flow_L_booking_stage_catch_L_cancel_charge_L_cancel_charge</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="logistics_shipment_err_EXIT_L_cancel_charge" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_L_booking_stage_catch_L_cancel_charge_L_cancel_charge" sourceRef="L_booking_stage_catch_L_cancel_charge" targetRef="L_cancel_charge" />
    <bpmn:sequenceFlow id="Flow_L_booking_stage_L_pickup" sourceRef="L_booking_stage" targetRef="L_pickup" />
    <bpmn:association id="Assoc_L_charge" sourceRef="L_charge_comp" targetRef="L_refund" associationDirection="One" />
  </bpmn:process>
  <bpmn:collaboration id="logistics_shipment_collab">
    <bpmn:participant id="logistics_shipment_pool" name="Assignment 2 - Logistics and Shipment Exception Management" processRef="logistics_shipment" />
  </bpmn:collaboration>
  <bpmn:error id="logistics_shipment_err_CANCEL_BOOKING" name="CANCEL_BOOKING" errorCode="CANCEL_BOOKING" />
  <bpmn:error id="logistics_shipment_err_PICKUP_FAILURE" name="PICKUP_FAILURE" errorCode="PICKUP_FAILURE" />
  <bpmn:error id="logistics_shipment_err_SCAN_FAILURE" name="SCAN_FAILURE" errorCode="SCAN_FAILURE" />
  <bpmn:message id="logistics_shipment_msg_customs_documents" name="logistics_shipment.customs_documents">
    </bpmn:message>
  <bpmn:error id="logistics_shipment_err_RETURN_REQUIRED" name="RETURN_REQUIRED" errorCode="RETURN_REQUIRED" />
  <bpmn:message id="logistics_shipment_msg_leg_arrived" name="logistics_shipment.leg_arrived">
    </bpmn:message>
  <bpmn:message id="logistics_shipment_msg_transit_delay" name="logistics_shipment.transit_delay">
    </bpmn:message>
  <bpmn:error id="logistics_shipment_err_PARCEL_LOST" name="PARCEL_LOST" errorCode="PARCEL_LOST" />
  <bpmn:message id="logistics_shipment_msg_depot_collected" name="logistics_shipment.depot_collected">
    </bpmn:message>
  <bpmn:message id="logistics_shipment_msg_address_corrected" name="logistics_shipment.address_corrected">
    </bpmn:message>
  <bpmn:message id="logistics_shipment_msg_cancel" name="logistics_shipment.cancel">
    </bpmn:message>
  <bpmn:error id="logistics_shipment_err_EXIT_L_cancel_charge" name="EXIT_L_cancel_charge" errorCode="EXIT_L_cancel_charge" />
  <bpmndi:BPMNDiagram id="Diagram_logistics_shipment">
    <bpmndi:BPMNPlane id="Plane_logistics_shipment" bpmnElement="logistics_shipment_collab">
